From c2d00b94c99e5550e30a0cc40b650d37cab5111f Mon Sep 17 00:00:00 2001
From: 77ph <tk@itarragon.net>
Date: Wed, 21 Oct 2026 14:56:10 +0300
Subject: [PATCH 1/7] fix(venue-base): DEFAULT_MULTISEND_ADDRESS lost its last
 hex digit

The constant had 39 hex digits; the final D of Safe MultiSendCallOnly v1.3.0
(0x40A2aCCbd92BCA938b02010E17A5b8929b49130D, as in
contracts/scripts/deploy-stolas-l2.ts) was missing, so any settlement batch
built from the default would fail viem's address validation.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../venue-base/src/writers/settlement.test.ts          | 10 +++++++++-
 .../marketplace/venue-base/src/writers/settlement.ts   |  8 ++++++--
 2 files changed, 15 insertions(+), 3 deletions(-)

diff --git a/packages/marketplace/venue-base/src/writers/settlement.test.ts b/packages/marketplace/venue-base/src/writers/settlement.test.ts
index 0ba8bce52..c9a802c8d 100644
--- a/packages/marketplace/venue-base/src/writers/settlement.test.ts
+++ b/packages/marketplace/venue-base/src/writers/settlement.test.ts
@@ -10,6 +10,7 @@ import { REVISED_COMMON_PROJECTOR_EVENTS_ABI } from "@jinn-network/marketplace-p
 import {
   encodeAbiParameters,
   encodeEventTopics,
+  isAddress,
   parseAbiParameters,
   toHex,
   type Address,
@@ -20,7 +21,7 @@ import {
 import { describe, expect, test, vi } from "vitest";
 import type { BaseVenueSafeBroadcaster, SafeBroadcastReceipt } from "../broadcast/safe-broadcaster.js";
 import type { ChainLogSource } from "../log-source/chain-log-source.js";
-import { createSettlementPorts, type SettlementWriterInput } from "./settlement.js";
+import { DEFAULT_MULTISEND_ADDRESS, createSettlementPorts, type SettlementWriterInput } from "./settlement.js";
 
 const REVISED_CONFIG = { ...BASE_SEPOLIA_TODAY, generation: "revised" as const };
 const SAFE_ADDRESS = "0x2222222222222222222222222222222222222222" as Address;
@@ -425,3 +426,10 @@ describe("pin and verifySettlementGrade pass-through", () => {
     expect(ports.verifySettlementGrade).toBe(input.verifySettlementGrade);
   });
 });
+
+describe("DEFAULT_MULTISEND_ADDRESS", () => {
+  test("is a whole address: Safe MultiSendCallOnly v1.3.0", () => {
+    expect(isAddress(DEFAULT_MULTISEND_ADDRESS)).toBe(true);
+    expect(DEFAULT_MULTISEND_ADDRESS).toBe("0x40A2aCCbd92BCA938b02010E17A5b8929b49130D");
+  });
+});
diff --git a/packages/marketplace/venue-base/src/writers/settlement.ts b/packages/marketplace/venue-base/src/writers/settlement.ts
index 88ea62c3f..b79254cbd 100644
--- a/packages/marketplace/venue-base/src/writers/settlement.ts
+++ b/packages/marketplace/venue-base/src/writers/settlement.ts
@@ -29,8 +29,12 @@ import {
 import type { BaseVenueSafeBroadcaster } from "../broadcast/safe-broadcaster.js";
 import type { ChainLogSource } from "../log-source/chain-log-source.js";
 
-/** Gnosis Safe `MultiSend` v1.3.0 canonical singleton (identical address across EVM chains). */
-export const DEFAULT_MULTISEND_ADDRESS = "0x40A2aCCbd92BCA938b02010E17A5b8929b49130" as Address;
+/**
+ * Safe `MultiSendCallOnly` v1.3.0 canonical singleton (identical address across EVM chains; the
+ * same one `contracts/scripts/deploy-stolas-l2.ts` uses). It is entered by DELEGATECALL and
+ * refuses nested DELEGATECALL legs.
+ */
+export const DEFAULT_MULTISEND_ADDRESS = "0x40A2aCCbd92BCA938b02010E17A5b8929b49130D" as Address;
 
 /** 50k blocks: generous enough to cover a delivery that lands between our own poll cycles. */
 export const DEFAULT_MECH_DELIVER_LOOKBACK_BLOCKS = 50_000n;
-- 
2.43.0

