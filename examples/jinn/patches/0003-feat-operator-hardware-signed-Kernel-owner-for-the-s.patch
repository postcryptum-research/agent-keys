+++ b/operator/src/signer/kernel-safe-broadcaster.ts
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: MIT
+
+// The venue's Safe broadcaster when the Safe's owner is a TPM_sign Kernel account (ERC-4337)
+// instead of an agent EOA. Plugged into `createBaseVenue({ safeBroadcaster })`.
+//
+// The EOA broadcaster signs the Safe transaction hash with the agent's private key (eth_sign,
+// v + 4) and sends `execTransaction` from that EOA. Here the Kernel account itself calls
+// `execTransaction` with a pre-validated signature (r = owner, s = 0, v = 1), which the Safe
+// accepts because `msg.sender` is that owner: no off-chain signature and no ERC-1271. The call
+// is one UserOperation signed by the agent's hardware key, and on-chain the account's
+// AgentPolicy judges the Safe transaction's inner call (or every MultiSendCallOnly leg) against
+// the mandate the owner installed.
+//
+// Idempotency. A `v = 1` signature does not commit to the Safe nonce, so a blind resend after
+// an attempt that did land would execute the same call twice. Two guards:
+//   1. agent-signer sends each Safe transaction as a batch that first asserts the Safe nonce it
+//      is meant for (`--safe-nonce`): a replay reverts instead of executing again;
+//   2. every attempt is written ahead to the venue's durable submission ledger, keyed by
+//      (chainId, Kernel, Safe nonce), with the userOpHash once known. When the Safe nonce of an
+//      unresolved attempt has since been consumed, the attempt is reconciled from the
+//      EntryPoint's `UserOperationEvent` -- adopted if it is ours and succeeded, never re-sent
+//      at a fresh Safe nonce.
+// For rows with `from` = a Kernel account, the ledger's `nonce` is the Safe nonce and `txHash`
+// holds the userOpHash; the EOA broadcaster's rows (from = an EOA) are untouched by this.
+import {
+  JINN_ROUTER_V3_ABI,
+  SAFE_ABI,
+  SafeInnerRevertError,
+  decodeSafeInnerRevert,
+  formatDecodedRevert,
+  type PostingOutcome,
+} from '@jinn-network/marketplace-binding';
+import {
+  classifyBroadcastError,
+  encodePreValidatedSignature,
+  type BaseVenueSafeBroadcaster,
+  type SafeBroadcasterDeps,
+  type SafeBroadcasterFactory,
+  type SafeBroadcastReceipt,
+  type SafeBroadcastRequest,
+  type VenueRevertClassification,
+} from '@jinn-network/marketplace-venue-base';
+import {
+  decodeEventLog,
+  encodeFunctionData,
+  parseAbi,
+  parseAbiItem,
+  zeroAddress,
+  type Address,
+  type Hex,
+  type Log,
+} from 'viem';
+
+import {
+  agentSignerSend as defaultSend,
+  AgentSignerError,
+  type AgentSignerCall,
+  type AgentSignerConfig,
+  type AgentSignerResult,
+} from './agent-signer-cli.js';
+
+export const ENTRY_POINT_V07 = '0x0000000071727De22E5E9d8BAf0edAc6f37da032' as const;
+const USER_OPERATION_EVENT = parseAbiItem(
+  'event UserOperationEvent(bytes32 indexed userOpHash, address indexed sender, address indexed paymaster, uint256 nonce, bool success, uint256 actualGasCost, uint256 actualGasUsed)',
+);
+const SAFE_NONCE_ABI = parseAbi(['function nonce() view returns (uint256)']);
+
+/**
+ * One bundle can carry several UserOperations. Ours are the logs between the previous
+ * UserOperationEvent (or the start) and our own; without this cut, a `TaskCreated` from someone
+ * else's operation in the same bundle would look like ours.
+ */
+export function userOpLogs(logs: readonly Log[], userOpHash: Hex): Log[] {
+  let start = 0;
+  for (let i = 0; i < logs.length; i++) {
+    const log = logs[i]!;
+    if (log.address.toLowerCase() !== ENTRY_POINT_V07.toLowerCase()) continue;
+    try {
+      const ev = decodeEventLog({ abi: [USER_OPERATION_EVENT], data: log.data, topics: log.topics as [Hex, ...Hex[]] });
+      if (ev.args.userOpHash.toLowerCase() === userOpHash.toLowerCase()) {
+        return logs.slice(start, i).filter((l) => l.address.toLowerCase() !== ENTRY_POINT_V07.toLowerCase());
+      }
+      start = i + 1;
+    } catch {
+      // BeforeExecution, Deposited, ... -- not a boundary
+    }
+  }
+  throw new Error(`UserOperationEvent ${userOpHash} is not in the bundle receipt`);
+}
+
+/** The broadcaster's own reading of an agent-signer failure, in venue-base's three classes. */
+export function classifyKernelBroadcastError(error: unknown): VenueRevertClassification {
+  if (error instanceof AgentSignerError) {
+    switch (error.kind) {
+      case 'nonce':
+      case 'hardware':
+        return 'retryable';
+      // Never resend blindly: the earlier copy may still land (reconcile by userOpHash instead).
+      case 'not-included':
+      default:
+        return 'permanent';
+    }
+  }
+  return classifyBroadcastError(error);
+}
+
+export interface KernelSafeBroadcasterInput extends SafeBroadcasterDeps {
+  /** `signer.account` is the Kernel account, owner of the Safe. */
+  readonly signer: AgentSignerConfig;
+  /** Injectable for tests; defaults to spawning agent-signer. */
+  readonly send?: (cfg: AgentSignerConfig, call: AgentSignerCall) => Promise<AgentSignerResult>;
+  /** How far back to look for an unreconciled attempt's UserOperationEvent. */
+  readonly reconcileLookbackBlocks?: bigint;
+  readonly now?: () => number;
+}
+
+export function createKernelSafeBroadcaster(input: KernelSafeBroadcasterInput): BaseVenueSafeBroadcaster {
+  const kernel = input.signer.account;
+  const signature = encodePreValidatedSignature(kernel);
+  const send = input.send ?? defaultSend;
+  const now = input.now ?? (() => Date.now());
+  const lookback = input.reconcileLookbackBlocks ?? 50_000n;
+  const key = (nonce: number) => ({ chainId: input.chainId, from: kernel, nonce });
+
+  function execCalldata(request: SafeBroadcastRequest): Hex {
+    // No refund (gasPrice 0, no gas token, no refund receiver): AgentPolicy refuses anything else.
+    return encodeFunctionData({
+      abi: SAFE_ABI,
+      functionName: 'execTransaction',
+      args: [
+        request.to, request.value, request.data, request.operation ?? 0,
+        0n, 0n, 0n, zeroAddress, zeroAddress, signature,
+      ],
+    });
+  }
+
+  async function decodeInner(request: SafeBroadcastRequest, txHash: Hex | null): Promise<SafeInnerRevertError | undefined> {
+    // eth_call cannot reproduce a DELEGATECALL into MultiSend from outside the Safe.
+    if ((request.operation ?? 0) === 1) return undefined;
+    const inner = await decodeSafeInnerRevert(input.publicClient, {
+      safeAddress: input.safeAddress, to: request.to, value: request.value, data: request.data,
+    });
+    if (inner.decodedName === null && inner.innerSelector === null) return undefined;
+    return new SafeInnerRevertError(
+      `Safe execTransaction inner revert (${request.logicalTx}): ${
+        inner.decodedName !== null ? formatDecodedRevert(inner.decodedName, inner.decodedArgs) : `undecoded selector ${inner.innerSelector}`
+      }`,
+      inner.innerSelector, inner.innerData, inner.decodedName, inner.decodedArgs, txHash,
+    );
+  }
+
+  /** The UserOperationEvent of `userOpHash`, if it was included. */
+  async function findUserOp(userOpHash: Hex): Promise<{ log: Log; success: boolean } | undefined> {
+    const latest = await input.publicClient.getBlockNumber();
+    const logs = await input.publicClient.getLogs({
+      address: ENTRY_POINT_V07,
+      event: USER_OPERATION_EVENT,
+      args: { userOpHash, sender: kernel },
+      fromBlock: latest > lookback ? latest - lookback : 0n,
+      toBlock: latest,
+    });
+    const log = logs[0];
+    return log === undefined ? undefined : { log, success: log.args.success === true };
+  }
+
+  async function receiptOf(txHash: Hex, userOpHash: Hex, alreadySettled = false): Promise<SafeBroadcastReceipt> {
+    const receipt = await input.publicClient.getTransactionReceipt({ hash: txHash });
+    return {
+      txHash, blockNumber: receipt.blockNumber, blockHash: receipt.blockHash,
+      logs: userOpLogs(receipt.logs, userOpHash), alreadySettled,
+    };
+  }
+
+  /**
+   * Attempts of this logicalTx whose Safe nonce has since been consumed. Ours and successful:
+   * adopt it (the call already ran). Otherwise the nonce went to another transaction: close the
+   * row and continue with a fresh attempt.
+   */
+  async function reconcile(request: SafeBroadcastRequest, data: Hex, safeNonce: number): Promise<SafeBroadcastReceipt | undefined> {
+    const stale = input.ledger.unresolvedBetween(input.chainId, kernel, 0, safeNonce)
+      .filter((row) => row.logicalTx === request.logicalTx && row.data?.toLowerCase() === data.toLowerCase());
+    for (const row of stale) {
+      const found = row.txHash === undefined ? undefined : await findUserOp(row.txHash);
+      input.ledger.markResolved(key(row.nonce), now());
+      if (found?.success === true && found.log.transactionHash !== null) {
+        return receiptOf(found.log.transactionHash, row.txHash!);
+      }
+    }
+    return undefined;
+  }
+
+  async function executeInner(request: SafeBroadcastRequest): Promise<SafeBroadcastReceipt> {
+    const data = execCalldata(request);
+    const safeNonce = Number(await input.publicClient.readContract({
+      address: input.safeAddress, abi: SAFE_NONCE_ABI, functionName: 'nonce',
+    }));
+    const adopted = await reconcile(request, data, safeNonce);
+    if (adopted !== undefined) return adopted;
+
+    // Write-ahead: the attempt exists in the ledger before anything is signed.
+    const base = {
+      ...key(safeNonce), logicalTx: request.logicalTx, to: input.safeAddress, value: request.value, data,
+      fees: {}, submittedAtMs: now(),
+    };
+    input.ledger.record(base);
+    try {
+      // The Safe pays `request.value` from its own balance; the outer call carries none.
+      const sent = await send(input.signer, { to: input.safeAddress, value: 0n, data, safeNonce: BigInt(safeNonce) });
+      input.ledger.record({ ...base, txHash: sent.userOpHash, resolvedAtMs: now() });
+      return await receiptOf(sent.txHash, sent.userOpHash);
+    } catch (error) {
+      if (!(error instanceof AgentSignerError)) throw error;
+      if (error.userOpHash !== null) {
+        // Kept unresolved: if it lands after all, the next attempt adopts it via reconcile().
+        input.ledger.record({ ...base, txHash: error.userOpHash });
+      }
+      if (error.kind === 'simulation-revert' || error.kind === 'execution-revert') {
+        const inner = await decodeInner(request, null);
+        if (inner !== undefined) {
+          if (classifyBroadcastError(inner) === 'already-settled') {
+            input.ledger.markResolved(key(safeNonce), now());
+            return { txHash: '0x' as Hex, blockNumber: 0n, blockHash: '0x' as Hex, logs: [], alreadySettled: true };
+          }
+          throw inner;
+        }
+      }
+      if (error.kind === 'policy-denied' || error.kind === 'policy-expired' || error.kind === 'config') {
+        input.ledger.markResolved(key(safeNonce), now());
+      }
+      throw error;
+    }
+  }
+
+  return {
+    classify: classifyKernelBroadcastError,
+
+    async execute(request) {
+      return input.lock.withSender(input.chainId, kernel, () => executeInner(request));
+    },
+
+    async broadcastCreateTask(createTask): Promise<PostingOutcome> {
+      const receipt = await this.execute({
+        to: createTask.to, value: createTask.value, data: createTask.data, logicalTx: 'posting.createTask',
+      });
+      for (const log of receipt.logs) {
+        try {
+          const decoded = decodeEventLog({
+            abi: JINN_ROUTER_V3_ABI, data: log.data, topics: log.topics as [Hex, ...Hex[]], strict: true,
+          });
+          if (decoded.eventName === 'TaskCreated') {
+            return { taskId: (decoded.args as unknown as { taskId: bigint }).taskId, txHash: receipt.txHash };
+          }
+        } catch {
+          // Not a router event.
+        }
+      }
+      throw new Error(`no TaskCreated event in the posting receipt (txHash=${receipt.txHash})`);
+    },
+  };
+}
+
+/** `createBaseVenue({ safeBroadcaster: kernelSafeBroadcasterFactory(signer) })`. */
+export function kernelSafeBroadcasterFactory(
+  signer: AgentSignerConfig,
+  extra: Omit<KernelSafeBroadcasterInput, keyof SafeBroadcasterDeps | 'signer'> = {},
+): SafeBroadcasterFactory {
+  return (deps) => createKernelSafeBroadcaster({ ...deps, ...extra, signer });
+}
+
+export type { Address };
