+// SPDX-License-Identifier: MIT
+
+// The `signer` section of the operator config, kept free of runtime imports: config.ts loads it
+// on every boot, the agent-signer code only when the section is present.
+import { z } from 'zod/v3';
+
+/**
+ * `"signer": { "kind": "agent-signer", ... }` -- the service Safe is owned by a Kernel account
+ * whose agent key lives in hardware; venue Safe transactions go through `agent-signer`.
+ */
+export const SignerSectionSchema = z
+  .object({
+    kind: z.literal('agent-signer'),
+    /** Path to the `agent-signer` binary (built with the backend this machine has). */
+    bin: z.string().min(1),
+    /** The agent config file `agent-signer --agent` reads (key location, permission, account). */
+    config: z.string().min(1),
+    /** The Kernel account: the service Safe's owner. Must match the agent config's `account`. */
+    account: z.string().regex(/^0x[0-9a-fA-F]{40}$/),
+    /** `.env` with the RPC / bundler URLs for agent-signer. */
+    envFile: z.string().optional(),
+    /** Gas from the TPM_sign whitelist paymaster. */
+    sponsored: z.boolean().default(false),
+    timeoutMs: z.number().int().positive().optional(),
+  })
+  .strict();
+
+export type SignerSection = z.infer<typeof SignerSectionSchema>;
