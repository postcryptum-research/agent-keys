+// agent-signer is replaced by a small Node script that records its argv and answers like the
+// real CLI: one JSON line on stdout on success; progress and `Error: ...` on stderr otherwise.
+import { chmodSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { createWalletClient, type Address, type Hex } from 'viem';
+import { baseSepolia } from 'viem/chains';
+
+import { agentSignerSend, AgentSignerError, classifyAgentSignerFailure } from '../../src/signer/agent-signer-cli.js';
+import { agentSignerTransport } from '../../src/signer/agent-signer-transport.js';
+import { SignerSectionSchema } from '../../src/signer/config.js';
+
+const KERNEL = '0xEdB645B14e2f952C5784e34949b58F0826fBc9E9' as Address;
+const OP = `0x${'a1'.repeat(32)}`;
+const TX = `0x${'c3'.repeat(32)}`;
+
+let dir: string;
+let bin: string;
+
+function fakeCli(mode: 'ok' | 'policy' | 'other-account') {
+  writeFileSync(join(dir, 'mode'), mode);
+  writeFileSync(bin, `#!/usr/bin/env node
+const fs = require('fs');
+fs.writeFileSync(${JSON.stringify(join(dir, 'argv.json'))}, JSON.stringify(process.argv.slice(2)));
+const mode = fs.readFileSync(${JSON.stringify(join(dir, 'mode'))}, 'utf8');
+process.stderr.write('nonce:          0x1\\nuserOpHash:     ${OP}\\n');
+if (mode === 'policy') {
+  process.stderr.write('Error: bundler rejected the operation\\n\\nCaused by:\\n    0x3e4983f6000000\\n');
+  process.exit(1);
+}
+const account = mode === 'other-account' ? '0x000000000000000000000000000000000000dEaD' : '${KERNEL}';
+process.stdout.write(JSON.stringify({ account, userOpHash: '${OP}', nonce: '0x1', tx: '${TX}', block: 42, gasUsed: 123 }) + '\\n');
+`);
+  chmodSync(bin, 0o755);
+}
+
+const argv = () => JSON.parse(readFileSync(join(dir, 'argv.json'), 'utf8')) as string[];
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'agent-signer-'));
+  bin = join(dir, 'agent-signer');
+});
+afterEach(() => { rmSync(dir, { recursive: true, force: true }); });
+
+describe('agentSignerSend', () => {
+  it('passes the call, the Safe nonce and the options, and parses the JSON result', async () => {
+    fakeCli('ok');
+    const envFile = join(dir, 'agent.env');
+    writeFileSync(envFile, '');
+    const r = await agentSignerSend(
+      { bin, configPath: 'agent.json', account: KERNEL, envFile, sponsored: true },
+      { to: KERNEL, value: 5n, data: '0xabcd', safeNonce: 9n, nonce: '0x77' as Hex },
+    );
+    expect(argv()).toEqual([
+      'op', 'send', '--agent', 'agent.json', '--target', KERNEL, '--wei', '5', '--data', '0xabcd', '--json',
+      '--env-file', envFile, '--sponsored', '--nonce', '0x77', '--safe-nonce', '9',
+    ]);
+    expect(r).toEqual({ account: KERNEL, userOpHash: OP, nonce: '0x1', txHash: TX, blockNumber: 42n, gasUsed: 123n });
+  });
+
+  it('a mandate refusal becomes policy-denied, with the userOpHash for reconciliation', async () => {
+    fakeCli('policy');
+    const e = await agentSignerSend({ bin, configPath: 'a.json', account: KERNEL }, { to: KERNEL, value: 0n, data: '0x' })
+      .catch((x: unknown) => x);
+    expect(e).toBeInstanceOf(AgentSignerError);
+    expect((e as AgentSignerError).kind).toBe('policy-denied');
+    expect((e as AgentSignerError).userOpHash).toBe(OP);
+    expect((e as AgentSignerError).message).toMatch(/bundler rejected the operation: 0x3e4983f6/);
+  });
+
+  it('refuses a result for another account', async () => {
+    fakeCli('other-account');
+    await expect(agentSignerSend({ bin, configPath: 'a.json', account: KERNEL }, { to: KERNEL, value: 0n, data: '0x' }))
+      .rejects.toThrow(/expected/);
+  });
+
+  it('a missing binary is a config error', async () => {
+    const e = await agentSignerSend({ bin: join(dir, 'nope'), configPath: 'a.json', account: KERNEL }, { to: KERNEL, value: 0n, data: '0x' })
+      .catch((x: unknown) => x);
+    expect((e as AgentSignerError).kind).toBe('config');
+  });
+
+  it('classifies the CLI failure texts', () => {
+    expect(classifyAgentSignerFailure('AA22 expired or not due')).toBe('policy-expired');
+    expect(classifyAgentSignerFailure('nonce 0x5 is already used: an operation with it was included')).toBe('nonce');
+    expect(classifyAgentSignerFailure('the operation was included but its execution reverted')).toBe('execution-revert');
+    expect(classifyAgentSignerFailure('Failed to open specified TCTI device file /dev/tpmrm0')).toBe('hardware');
+  });
+});
+
+describe('agentSignerTransport', () => {
+  it('sends transactions through agent-signer and refuses off-chain signing', async () => {
+    fakeCli('ok');
+    const wallet = createWalletClient({
+      account: KERNEL, chain: baseSepolia,
+      transport: agentSignerTransport('http://127.0.0.1:1', { bin, configPath: 'agent.json', account: KERNEL }),
+    });
+    // The raw request viem's sendTransaction ends in for a json-rpc (address-only) account.
+    const hash = await wallet.request({ method: 'eth_sendTransaction', params: [{ from: KERNEL, to: KERNEL, data: '0x1234', value: '0x0' }] });
+    expect(hash).toBe(TX);
+    expect(argv()).toContain('0x1234');
+    await expect(wallet.signMessage({ message: 'hi' })).rejects.toThrow(/signs no off-chain messages/);
+    await expect(wallet.signTypedData({
+      domain: { name: 'x' }, types: { M: [{ name: 'a', type: 'uint256' }] }, primaryType: 'M', message: { a: 1n },
+    })).rejects.toThrow(/signs no off-chain messages/);
+  });
+});
+
+describe('the `signer` config section', () => {
+  it('accepts an agent-signer section and rejects typos', () => {
+    const ok = SignerSectionSchema.parse({ kind: 'agent-signer', bin: '/usr/bin/agent-signer', config: 'a.json', account: KERNEL });
+    expect(ok.sponsored).toBe(false);
+    expect(() => SignerSectionSchema.parse({ kind: 'agent-signer', bin: 'b', config: 'c', account: KERNEL, sponsor: true }))
+      .toThrow();
+    expect(() => SignerSectionSchema.parse({ kind: 'keystore', bin: 'b', config: 'c', account: KERNEL })).toThrow();
+    expect(() => SignerSectionSchema.parse({ kind: 'agent-signer', bin: 'b', config: 'c', account: '0x1234' })).toThrow();
+  });
+});
