--- /dev/null
+++ b/operator/src/signer/index.ts
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+
+// Hardware-signed agent account (TPM_sign): the optional `signer` section of the operator config
+// and what the daemon builds from it. Without the section nothing here is loaded and the daemon
+// keeps signing with the keystore's agent EOA.
+import { parseAbi, type Address, type PublicClient } from 'viem';
+import type { SafeBroadcasterFactory } from '@jinn-network/marketplace-venue-base';
+
+import type { AgentSignerConfig } from './agent-signer-cli.js';
+import type { SignerSection } from './config.js';
+import { kernelSafeBroadcasterFactory } from './kernel-safe-broadcaster.js';
+
+export { SignerSectionSchema, type SignerSection } from './config.js';
+export { agentSignerSend, AgentSignerError, type AgentSignerConfig } from './agent-signer-cli.js';
+export { agentSignerTransport } from './agent-signer-transport.js';
+export { createKernelSafeBroadcaster, kernelSafeBroadcasterFactory, userOpLogs } from './kernel-safe-broadcaster.js';
+
+export function agentSignerConfigOf(section: SignerSection): AgentSignerConfig {
+  return {
+    bin: section.bin,
+    configPath: section.config,
+    account: section.account as Address,
+    sponsored: section.sponsored,
+    ...(section.envFile === undefined ? {} : { envFile: section.envFile }),
+    ...(section.timeoutMs === undefined ? {} : { timeoutMs: section.timeoutMs }),
+  };
+}
+
+const SAFE_OWNER_ABI = parseAbi(['function isOwner(address owner) view returns (bool)']);
+
+/**
+ * The venue's Safe broadcaster for a `signer` section, after checking on-chain that the Kernel
+ * account owns the service Safe -- refusing at boot rather than at the first claim.
+ */
+export async function agentSignerSafeBroadcaster(
+  section: SignerSection,
+  publicClient: PublicClient,
+  safeAddress: Address,
+): Promise<SafeBroadcasterFactory> {
+  const signer = agentSignerConfigOf(section);
+  const owner = await publicClient.readContract({
+    address: safeAddress, abi: SAFE_OWNER_ABI, functionName: 'isOwner', args: [signer.account],
+  });
+  if (owner !== true) {
+    throw new Error(
+      `signer.account ${signer.account} is not an owner of the service Safe ${safeAddress}: `
+      + 'make the Kernel account the Safe owner (swapOwner from the agent EOA) before switching the signer',
+    );
+  }
+  return kernelSafeBroadcasterFactory(signer);
+}
diff --git a/operator/src/signer/kernel-safe-broadcaster.ts b/operator/src/signer/kernel-safe-broadcaster.ts
