+// The Kernel-owned Safe broadcaster against venue-base's REAL durable ledger and lock (SQLite in a
+// temp dir); the chain and agent-signer are scripted. What is pinned: the exact Safe call it
+// sends (pre-validated v = 1 signature from the Kernel, no refund, the Safe nonce asserted), the
+// write-ahead ledger row, adoption of an attempt that landed after an unknown outcome instead of
+// a second execution, and the error classes the venue retries on.
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+  decodeFunctionData,
+  encodeAbiParameters,
+  encodeEventTopics,
+  parseAbi,
+  parseAbiItem,
+  type Address,
+  type Hex,
+  type Log,
+} from 'viem';
+import {
+  createBroadcastLock,
+  createSubmissionLedger,
+  openVenueState,
+  type SubmissionLedger,
+} from '@jinn-network/marketplace-venue-base';
+
+import { AgentSignerError, type AgentSignerCall, type AgentSignerResult } from '../../src/signer/agent-signer-cli.js';
+import {
+  ENTRY_POINT_V07,
+  createKernelSafeBroadcaster,
+  userOpLogs,
+} from '../../src/signer/kernel-safe-broadcaster.js';
+
+type BroadcasterInput = Parameters<typeof createKernelSafeBroadcaster>[0];
+
+const KERNEL = '0xEdB645B14e2f952C5784e34949b58F0826fBc9E9' as Address;
+const SAFE = '0xd0b972a8ee7D8AB91a2e3381Eb6F10550B80E52A' as Address;
+const ROUTER = '0x1111111111111111111111111111111111111111' as Address;
+const CHAIN_ID = 84532;
+const OP1 = `0x${'a1'.repeat(32)}` as Hex;
+const OP2 = `0x${'b2'.repeat(32)}` as Hex;
+const TX1 = `0x${'c3'.repeat(32)}` as Hex;
+const TX2 = `0x${'d4'.repeat(32)}` as Hex;
+
+const EXEC_ABI = parseAbi([
+  'function execTransaction(address to, uint256 value, bytes data, uint8 operation, uint256 safeTxGas, uint256 baseGas, uint256 gasPrice, address gasToken, address refundReceiver, bytes signatures) payable returns (bool)',
+]);
+const USER_OPERATION_EVENT = parseAbiItem(
+  'event UserOperationEvent(bytes32 indexed userOpHash, address indexed sender, address indexed paymaster, uint256 nonce, bool success, uint256 actualGasCost, uint256 actualGasUsed)',
+);
+
+function userOpEvent(userOpHash: Hex, success: boolean, txHash: Hex = TX1): Log {
+  return {
+    address: ENTRY_POINT_V07,
+    topics: encodeEventTopics({
+      abi: [USER_OPERATION_EVENT], eventName: 'UserOperationEvent',
+      args: { userOpHash, sender: KERNEL, paymaster: '0x0000000000000000000000000000000000000000' },
+    }) as [Hex, ...Hex[]],
+    data: encodeAbiParameters(
+      [{ type: 'uint256' }, { type: 'bool' }, { type: 'uint256' }, { type: 'uint256' }],
+      [0n, success, 1n, 1n],
+    ),
+    transactionHash: txHash,
+    blockNumber: 10n, blockHash: `0x${'0e'.repeat(32)}`, logIndex: 0, transactionIndex: 0, removed: false,
+  } as unknown as Log;
+}
+
+function plainLog(address: Address, tag: string): Log {
+  return { address, topics: [`0x${tag.repeat(64).slice(0, 64)}`], data: '0x' } as unknown as Log;
+}
+
+/** A scripted chain: Safe nonce, receipts by tx hash, UserOperationEvents for getLogs. */
+function chain() {
+  const state = {
+    safeNonce: 7n,
+    receipts: new Map<Hex, readonly Log[]>(),
+    userOps: [] as Log[],
+  };
+  const client = {
+    async readContract(args: { functionName: string }) {
+      if (args.functionName === 'nonce') return state.safeNonce;
+      throw new Error(`unexpected read ${args.functionName}`);
+    },
+    async getTransactionReceipt({ hash }: { hash: Hex }) {
+      const logs = state.receipts.get(hash);
+      if (logs === undefined) throw new Error(`no receipt ${hash}`);
+      return { blockNumber: 10n, blockHash: `0x${'0e'.repeat(32)}`, logs, status: 'success' };
+    },
+    async getBlockNumber() { return 100n; },
+    async getLogs({ args }: { args: { userOpHash: Hex } }) {
+      return state.userOps
+        .filter((l) => l.topics[1]!.toLowerCase() === args.userOpHash.toLowerCase())
+        .map((l) => ({ ...l, args: { success: (l.data.slice(2 + 64, 2 + 128).endsWith('1')) } }));
+    },
+  };
+  // venue-base resolves its own copy of viem (finding E26 in composition-root.ts): name the
+  // exact type the broadcaster's deps expect rather than the operator's PublicClient.
+  return { state, publicClient: client as unknown as BroadcasterInput['publicClient'] };
+}
+
+let root: string;
+let ledger: SubmissionLedger;
+let lock: ReturnType<typeof createBroadcastLock>;
+let close: () => void;
+
+beforeEach(() => {
+  root = mkdtempSync(join(tmpdir(), 'kernel-safe-'));
+  const state = openVenueState(join(root, 'venue.db'));
+  ledger = createSubmissionLedger(state);
+  lock = createBroadcastLock(state);
+  close = () => state.close();
+});
+afterEach(() => {
+  close();
+  rmSync(root, { recursive: true, force: true });
+});
+
+const signer = { bin: 'agent-signer', configPath: 'agent.json', account: KERNEL };
+const request = { to: ROUTER, value: 0n, data: '0x12345678' as Hex, logicalTx: 'claim.task-1' };
+
+describe('createKernelSafeBroadcaster', () => {
+  it('sends execTransaction from the Kernel with a v = 1 signature, no refund, and the Safe nonce asserted', async () => {
+    const { state, publicClient } = chain();
+    state.receipts.set(TX1, [plainLog(ROUTER, 'aa'), userOpEvent(OP1, true)]);
+    const calls: AgentSignerCall[] = [];
+    const send = vi.fn(async (_cfg, call: AgentSignerCall): Promise<AgentSignerResult> => {
+      calls.push(call);
+      return { account: KERNEL, userOpHash: OP1, nonce: '0x1', txHash: TX1, blockNumber: 10n, gasUsed: 1n };
+    });
+    const b = createKernelSafeBroadcaster({ chainId: CHAIN_ID, safeAddress: SAFE, publicClient, ledger, lock, signer, send });
+
+    const receipt = await b.execute(request);
+
+    expect(calls).toHaveLength(1);
+    expect(calls[0]!.to).toBe(SAFE);
+    expect(calls[0]!.value).toBe(0n);
+    expect(calls[0]!.safeNonce).toBe(7n);
+    const exec = decodeFunctionData({ abi: EXEC_ABI, data: calls[0]!.data });
+    const [to, value, data, operation, safeTxGas, baseGas, gasPrice, gasToken, refundReceiver, sig] = exec.args;
+    expect([to, value, data, operation]).toEqual([ROUTER, 0n, '0x12345678', 0]);
+    expect([safeTxGas, baseGas, gasPrice]).toEqual([0n, 0n, 0n]);
+    expect([gasToken, refundReceiver]).toEqual(['0x0000000000000000000000000000000000000000', '0x0000000000000000000000000000000000000000']);
+    expect(sig).toBe(`0x${KERNEL.slice(2).toLowerCase().padStart(64, '0')}${'0'.repeat(64)}01`);
+
+    expect(receipt.txHash).toBe(TX1);
+    expect(receipt.alreadySettled).toBe(false);
+    expect(receipt.logs).toHaveLength(1); // only our userOp's logs, without the EntryPoint event
+    const row = ledger.get({ chainId: CHAIN_ID, from: KERNEL, nonce: 7 });
+    expect(row?.txHash).toBe(OP1);
+    expect(row?.logicalTx).toBe('claim.task-1');
+    expect(row?.resolvedAtMs).toBeDefined();
+  });
+
+  it('adopts an attempt that landed after an unknown outcome instead of executing it again', async () => {
+    const { state, publicClient } = chain();
+    let attempts = 0;
+    const send = vi.fn(async (): Promise<AgentSignerResult> => {
+      attempts += 1;
+      throw new AgentSignerError('not-included', 'not included within 120 s', 'userOpHash: ' + OP1, null, OP1);
+    });
+    const b = createKernelSafeBroadcaster({ chainId: CHAIN_ID, safeAddress: SAFE, publicClient, ledger, lock, signer, send });
+
+    const first = await b.execute(request).catch((e: unknown) => e);
+    expect(first).toBeInstanceOf(AgentSignerError);
