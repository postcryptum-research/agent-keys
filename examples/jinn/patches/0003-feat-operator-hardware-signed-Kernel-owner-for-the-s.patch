diff --git a/operator/src/signer/agent-signer-cli.ts b/operator/src/signer/agent-signer-cli.ts
new file mode 100644
index 000000000..4a09bb5e7
--- /dev/null
+++ b/operator/src/signer/agent-signer-cli.ts
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: MIT
+
+// `agent-signer op send --json` (TPM_sign) as a typed call. The CLI owns everything that touches
+// the agent key: it builds an ERC-4337 UserOperation for the agent's Kernel account, has the key
+// sign it inside a TPM / Secure Enclave / TROPIC01, and waits for inclusion. This process only
+// sees the result -- there is no key material here to load, derive or leak.
+//
+// On-chain, the account's AgentPolicy judges every call (and, for `Safe.execTransaction`, the
+// Safe transaction's inner call) against the mandate its owner installed.
+import { spawn } from 'node:child_process';
+import type { Address, Hex } from 'viem';
+
+export interface AgentSignerConfig {
+  /** Path to the `agent-signer` binary. */
+  readonly bin: string;
+  /** Agent account config (`--agent`): key location, permission id, pinned account. */
+  readonly configPath: string;
+  /** The Kernel account the config pins; every result is checked against it. */
+  readonly account: Address;
+  /** `.env` with the RPC / bundler URLs (`--env-file`). */
+  readonly envFile?: string;
+  /** Gas from the whitelist paymaster instead of the account's EntryPoint deposit. */
+  readonly sponsored?: boolean;
+  /** The CLI waits up to 120 s for inclusion by itself; keep this above that. */
+  readonly timeoutMs?: number;
+}
+
+export interface AgentSignerResult {
+  readonly account: Address;
+  readonly userOpHash: Hex;
+  /** EntryPoint nonce the operation used. */
+  readonly nonce: Hex;
+  readonly txHash: Hex;
+  readonly blockNumber: bigint;
+  readonly gasUsed: bigint;
+}
+
+export type AgentSignerErrorKind =
+  /** The account's AgentPolicy refused the operation (Kernel `PolicyFailed`): never retry. */
+  | 'policy-denied'
+  /** The permission's window is over (AA22). */
+  | 'policy-expired'
+  /** EntryPoint nonce race (AA25) or an already-used pinned nonce: reconcile, then retry. */
+  | 'nonce'
+  /** The bundler's simulation hit a revert of the call itself. */
+  | 'simulation-revert'
+  /** Included, but the call reverted (UserOperationEvent.success == false). */
+  | 'execution-revert'
+  /** Accepted by the bundler and not seen included: the outcome is UNKNOWN. */
+  | 'not-included'
+  /** TPM / Secure Enclave / TROPIC01 access. */
+  | 'hardware'
+  | 'config'
+  | 'unknown';
+
+/** Kernel's `PolicyFailed(uint256)` selector. */
+const POLICY_FAILED = '3e4983f6';
+const USER_OP_HASH_RE = /userOpHash:\s+(0x[0-9a-fA-F]{64})/;
+
+export class AgentSignerError extends Error {
+  override readonly name = 'AgentSignerError';
+  constructor(
+    readonly kind: AgentSignerErrorKind,
+    message: string,
+    readonly stderr: string,
+    readonly exitCode: number | null,
+    /** Set once the CLI computed it: the handle to reconcile an unknown outcome. */
+    readonly userOpHash: Hex | null,
+  ) {
+    super(message);
+  }
+}
+
+export function classifyAgentSignerFailure(stderr: string): AgentSignerErrorKind {
+  if (stderr.includes(POLICY_FAILED)) return 'policy-denied';
+  if (/AA22/.test(stderr)) return 'policy-expired';
+  if (/AA25|invalid account nonce|is already used/i.test(stderr)) return 'nonce';
+  if (/AA2\d|signature error/i.test(stderr)) return 'policy-denied';
+  if (/its execution reverted/.test(stderr)) return 'execution-revert';
+  if (/reverted during simulation|eth_estimateUserOperationGas/.test(stderr)) return 'simulation-revert';
+  if (/not included|timed out|waiting for/i.test(stderr)) return 'not-included';
+  if (/tpmrm0|ttyACM|TROPIC01|Secure Enclave|tcti/i.test(stderr)) return 'hardware';
+  if (/needs `--features|No such file|loading /i.test(stderr)) return 'config';
+  return 'unknown';
+}
+
+/** The CLI's `Error: ... Caused by: ...` report as one line. */
+function reason(stderr: string): string {
+  const at = stderr.lastIndexOf('Error: ');
+  return (at >= 0 ? stderr.slice(at + 7) : stderr)
+    .split('\n')
+    .filter((line) => !line.startsWith('ERROR:tcti'))
+    .map((line) => line.trim())
+    .filter(Boolean)
+    .join(' ')
+    .replace(/\s*Caused by:\s*/g, ': ');
+}
+
+export interface AgentSignerCall {
+  readonly to: Address;
+  readonly value: bigint;
+  readonly data: Hex;
+  /** Sign on the owner's root path instead of the agent permission (owner-key operations). */
+  readonly root?: boolean;
+  /**
+   * For `Safe.execTransaction` calldata: the Safe nonce it is meant for. agent-signer sends it
+   * as a batch that asserts that nonce on-chain first -- the only shape the agent's mandate
+   * admits -- so a replay reverts instead of executing twice.
+   */
+  readonly safeNonce?: bigint;
+  /** Pin the EntryPoint nonce (from an earlier attempt) instead of taking the next free one. */
+  readonly nonce?: Hex;
+}
+
+/** Send one call from the Kernel account, signed in hardware; resolves once it is included. */
+export function agentSignerSend(cfg: AgentSignerConfig, call: AgentSignerCall): Promise<AgentSignerResult> {
+  const args = [
+    'op', 'send', '--agent', cfg.configPath,
+    '--target', call.to, '--wei', call.value.toString(), '--data', call.data, '--json',
+  ];
+  if (cfg.envFile !== undefined) args.push('--env-file', cfg.envFile);
+  if (cfg.sponsored === true) args.push('--sponsored');
+  if (call.root === true) args.push('--root');
+  if (call.nonce !== undefined) args.push('--nonce', call.nonce);
+  if (call.safeNonce !== undefined) args.push('--safe-nonce', call.safeNonce.toString());
+
+  return new Promise((resolve, reject) => {
+    const child = spawn(cfg.bin, args, { stdio: ['ignore', 'pipe', 'pipe'] });
+    let stdout = '';
+    let stderr = '';
+    child.stdout.setEncoding('utf8').on('data', (chunk: string) => { stdout += chunk; });
+    child.stderr.setEncoding('utf8').on('data', (chunk: string) => { stderr += chunk; });
+    const timer = setTimeout(() => child.kill('SIGTERM'), cfg.timeoutMs ?? 180_000);
+
+    child.on('error', (err) => {
+      clearTimeout(timer);
+      reject(new AgentSignerError('config', `cannot run ${cfg.bin}: ${err.message}`, stderr, null, null));
+    });
+    child.on('close', (code) => {
+      clearTimeout(timer);
+      const opHash = (stderr.match(USER_OP_HASH_RE)?.[1] ?? null) as Hex | null;
+      if (code !== 0) {
+        // Killed by our timeout after the bundler accepted: the outcome is unknown.
+        const kind = code === null && opHash !== null ? 'not-included' : classifyAgentSignerFailure(stderr);
+        reject(new AgentSignerError(kind, reason(stderr) || `agent-signer exited with ${code}`, stderr, code, opHash));
+        return;
+      }
+      try {
+        const out = JSON.parse(stdout.trim().split('\n').at(-1)!) as {
+          account: string; userOpHash: string; nonce: string; tx: string; block: number; gasUsed: number;
+        };
+        if (out.account.toLowerCase() !== cfg.account.toLowerCase()) {
+          throw new Error(`agent-signer used account ${out.account}, expected ${cfg.account}`);
+        }
+        resolve({
+          account: out.account as Address,
+          userOpHash: out.userOpHash as Hex,
+          nonce: out.nonce as Hex,
+          txHash: out.tx as Hex,
+          blockNumber: BigInt(out.block),
+          gasUsed: BigInt(out.gasUsed),
+        });
+      } catch (e) {
+        reject(new AgentSignerError('unknown', `unexpected agent-signer output: ${String(e)}`, stderr, code, opHash));
+      }
+    });
+  });
+}
diff --git a/operator/src/signer/agent-signer-transport.ts b/operator/src/signer/agent-signer-transport.ts
new file mode 100644
index 000000000..33c8bc21c
--- /dev/null
+++ b/operator/src/signer/agent-signer-transport.ts
@@ -0,0 +1,42 @@
+// SPDX-License-Identifier: MIT
+
+// A viem transport for calls the operator makes directly from the agent's account (not through
+// the Safe): ERC-8004 IdentityRegistry.setMetadata, ValidationRegistry requests. Transactions go
+// to agent-signer; every read goes to the RPC. Message and typed-data signing fail loudly: the
+// Kernel agent signs no off-chain messages (its AgentPolicy refuses ERC-1271).
+//
+//   const walletClient = createWalletClient({
+//     account: signer.account, chain: baseSepolia, transport: agentSignerTransport(rpcUrl, signer),
+//   });
+import { custom, http, type Address, type Hex } from 'viem';
+
+import { agentSignerSend, type AgentSignerCall, type AgentSignerConfig, type AgentSignerResult } from './agent-signer-cli.js';
+
+const SIGNING_METHODS = /^(personal_sign|eth_sign|eth_signTypedData(_v[34])?|eth_signTransaction)$/;
+
+export function agentSignerTransport(
+  rpcUrl: string,
+  cfg: AgentSignerConfig,
+  send: (cfg: AgentSignerConfig, call: AgentSignerCall) => Promise<AgentSignerResult> = agentSignerSend,
+) {
+  const rpc = http(rpcUrl)({});
+  return custom({
+    async request({ method, params }) {
+      if (method === 'eth_sendTransaction') {
+        const [tx] = params as [{ from?: Address; to?: Address; value?: Hex; data?: Hex }];
+        if (tx.from !== undefined && tx.from.toLowerCase() !== cfg.account.toLowerCase()) {
+          throw new Error(`eth_sendTransaction from ${tx.from}, but the agent account is ${cfg.account}`);
+        }
+        if (tx.to === undefined) throw new Error('contract deployment from the agent account is not supported');
+        const sent = await send(cfg, { to: tx.to, value: BigInt(tx.value ?? '0x0'), data: tx.data ?? '0x' });
+        // Included already: a following waitForTransactionReceipt returns at once.
+        return sent.txHash;
+      }
+      if (method === 'eth_accounts' || method === 'eth_requestAccounts') return [cfg.account];
+      if (SIGNING_METHODS.test(method)) {
+        throw new Error(`${method}: the Kernel agent account signs no off-chain messages (ERC-1271 is refused by its policy)`);
+      }
+      return rpc.request({ method, params } as never);
+    },
+  });
+}
