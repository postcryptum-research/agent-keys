From 22b11f5a1457f596a5ddf6b57a9cc98d16e51584 Mon Sep 17 00:00:00 2001
From: agent-keys <noreply@agent-keys.invalid>
Date: Sat, 28 Nov 2026 12:07:18 +0000
Subject: [PATCH 19/20] fix(operator): signer-migrate's JSON output is
 schemaVersion 2

The output kept `schemaVersion: 1` while its steps changed. A point of #250 in the agent-keys
repository (B4). From 1 to 2:

- `safe-modules` is a new first step, with the new status `review` and the new field
  `modules` (the Safe's enabled modules);
- `kernel-approves-safe` (the Kernel sent the grant: `done`, `already`, `would`,
  `not-applicable`) is gone; `owner-approved-safe` takes its place as a read (`checked`, or
  `not-applicable` without an identity; a missing grant is a refusal);
- `safe-owner` comes after `agent-nft` and `attestation-key`, no longer before them;
- `agent-proof` is a new step after `mandate-admits-safe` (`checked`, or `not-applicable`).

No reader in this repository parses the output; the version tells a reader elsewhere which
shape it has.

- signer/migrate.ts: MigrationOutput's schemaVersion is 2, and its doc lists the changes.
- tests: unit, migrateTargets' output says schemaVersion 2.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 operator/src/signer/migrate.ts       | 12 +++++++++---
 operator/test/signer/migrate.test.ts |  2 +-
 2 files changed, 10 insertions(+), 4 deletions(-)

diff --git a/operator/src/signer/migrate.ts b/operator/src/signer/migrate.ts
index 359733f93..cf43bcb81 100644
--- a/operator/src/signer/migrate.ts
+++ b/operator/src/signer/migrate.ts
@@ -687,9 +687,15 @@ export async function migrateToKernelOwner(input: MigrationInput): Promise<reado
   return steps;
 }
 
-/** What `jinn signer-migrate` prints (`--json`): every Safe it handed over, or would, in order. */
+/**
+ * What `jinn signer-migrate` prints (`--json`): every Safe it handed over, or would, in order.
+ * Version 2 since the steps of version 1 changed: `safe-modules` came first (with the status
+ * `review` and the field `modules`), `owner-approved-safe` (a read) took the place of
+ * `kernel-approves-safe` (a grant the Kernel sent), `safe-owner` moved after `attestation-key`,
+ * and `agent-proof` was added.
+ */
 export interface MigrationOutput {
-  readonly schemaVersion: 1;
+  readonly schemaVersion: 2;
   readonly dryRun: boolean;
   readonly kernel: Address;
   readonly agentEoa: Address;
@@ -727,7 +733,7 @@ export async function migrateTargets(
     safes.push({ label: target.label, safe: target.safeAddress, steps: await named(target, '', () => migrateToKernelOwner(of(target))) });
   }
   return {
-    schemaVersion: 1,
+    schemaVersion: 2,
     dryRun: input.dryRun === true,
     kernel: getAddress(input.kernel),
     agentEoa: getAddress(input.agentEoaWallet.account!.address),
diff --git a/operator/test/signer/migrate.test.ts b/operator/test/signer/migrate.test.ts
index 5679a4d7c..d6e606376 100644
--- a/operator/test/signer/migrate.test.ts
+++ b/operator/test/signer/migrate.test.ts
@@ -408,7 +408,7 @@ describe('migrateTargets: every Safe is checked before the first changes hands',
   it('with both Safes clear, each is handed over in turn and the output lists both', async () => {
     const { input, sent, state, fleetState } = setup({ kernelCode: '0x6001', admits: true, userOps: [agentOp()] });
     const output = await migrateTargets(common(input), both);
-    expect(output).toMatchObject({ dryRun: false, kernel: KERNEL, agentEoa: EOA });
+    expect(output).toMatchObject({ schemaVersion: 2, dryRun: false, kernel: KERNEL, agentEoa: EOA });
     expect(output.safes.map((s) => [s.label, s.safe, s.steps.find((step) => step.step === 'safe-owner')!.status])).toEqual([
       ['service', SAFE, 'done'], ['fleet identity', FLEET_SAFE, 'done'],
     ]);
