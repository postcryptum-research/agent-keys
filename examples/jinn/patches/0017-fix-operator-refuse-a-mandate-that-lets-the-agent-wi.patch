+
+/** The agent config at `path`: its permission and its mandate's allow-list. */
+export function readAgentConfig(path: string): AgentConfigMandate {
+  const raw = JSON.parse(readFileSync(path, 'utf8')) as { permissionId?: unknown; policy?: { allow?: unknown } };
+  if (typeof raw.permissionId !== 'string') throw new Error(`${path} has no permissionId`);
+  const allow = raw.policy?.allow;
+  if (!Array.isArray(allow) || !allow.every((e: { target?: unknown; selector?: unknown } | null) =>
+    typeof e?.target === 'string' && typeof e.selector === 'string')) {
+    throw new Error(`${path} has no policy.allow list of { target, selector }`);
+  }
+  return { path, permissionId: raw.permissionId as Hex, allow: allow as MandateEntry[] };
+}
+
+/** The AgentPolicy of `permissionId` on the Kernel, or undefined when the Kernel has no code or no such permission. */
+async function installedPolicy(
+  pc: Pick<PublicClient, 'readContract' | 'getCode'>, kernel: Address, permissionId: Hex,
+): Promise<Address | undefined> {
+  const code = await pc.getCode({ address: kernel });
+  if (code === undefined || code === '0x') return undefined;
+  const config = await pc.readContract({ address: kernel, abi: KERNEL_ABI, functionName: 'permissionConfig', args: [permissionId] });
+  const policyData = config.policyData[0];
+  return config.signer === zeroAddress || policyData === undefined ? undefined : getAddress(`0x${policyData.slice(-40)}`);
+}
+
+/**
+ * Refuse a mandate under which the agent can withdraw the owner's standing grant to a Safe:
+ * `(IdentityRegistry, setApprovalForAll)` admits `setApprovalForAll(Safe, false)` from the agent
+ * alone. AgentPolicy refuses an operation that leaves an operator grant open, not one that
+ * withdraws it, and it cannot hold the call to its arguments. The entry is read in the agent
+ * config (what the owner's next rotation installs) and, when the Kernel has the permission
+ * installed, in its AgentPolicy (what binds the agent now). The migration (step 2) and the
+ * daemon's boot run it for each Safe with an ERC-8004 identity.
+ */
+export async function assertMandateKeepsOwnersGrant(input: {
+  readonly publicClient: Pick<PublicClient, 'readContract' | 'getCode'>;
+  readonly kernel: Address;
+  readonly agentConfig: AgentConfigMandate;
+  readonly identityRegistry: Address;
+}): Promise<void> {
+  const kernel = getAddress(input.kernel);
+  const registry = getAddress(input.identityRegistry);
+  const { path, permissionId, allow } = input.agentConfig;
+  const found: string[] = [];
+  if (allow.some((entry) => isAddress(entry.target) && getAddress(entry.target) === registry
+    && entry.selector.toLowerCase() === SET_APPROVAL_FOR_ALL_SELECTOR)) {
+    found.push(`the agent config ${path} lists it in policy.allow`);
+  }
+  const policy = await installedPolicy(input.publicClient, kernel, permissionId);
+  if (policy !== undefined && await input.publicClient.readContract({
+    address: policy, abi: POLICY_ABI, functionName: 'isAllowed',
+    args: [kernel, `${permissionId}${'0'.repeat(56)}` as Hex, registry, SET_APPROVAL_FOR_ALL_SELECTOR],
+  })) {
+    found.push(`the mandate installed on the Kernel ${kernel} (permission ${permissionId}, policy ${policy}) admits it`);
+  }
+  if (found.length > 0) {
+    throw new Error(
+      `the agent's mandate admits (IdentityRegistry ${registry}, setApprovalForAll): ${found.join('; ')}. With it the agent `
+      + 'can withdraw, alone, the owner\'s standing grant to the Safe (setApprovalForAll(Safe, false)): AgentPolicy refuses a '
+      + 'grant left open, not its withdrawal, and cannot hold the call to its arguments. The grant is the owner\'s and the '
+      + 'mandate needs no such entry. The owner rotates the permission to a mandate without it (the entry removed from '
+      + 'policy.allow, then agent-signer permission rotate, signed with the owner key), then run again',
+    );
+  }
 }
 
