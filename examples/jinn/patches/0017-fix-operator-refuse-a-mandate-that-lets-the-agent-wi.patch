+// #250 B2: an agent config whose mandate lists (IdentityRegistry, setApprovalForAll) lets the agent
+// withdraw the owner's standing grant alone (setApprovalForAll(Safe, false)).
+describe('the mandate cannot withdraw the owner\'s grant', () => {
+  const GRANT_ENTRY = { target: REGISTRY, selector: '0xa22cb465' };
+  const identity = (): Identity => ({ approved: true, nftOwner: EOA, metadata: '0x' });
+
+  it('the migration refuses an agent config that lists (IdentityRegistry, setApprovalForAll), in a dry run too, and sends nothing', async () => {
+    for (const entry of [GRANT_ENTRY, { target: REGISTRY.toLowerCase(), selector: '0xA22CB465' }]) {
+      for (const dryRun of [false, true]) {
+        const { input, sent, state } = setup({ kernelCode: '0x6001', admits: true, identity: identity(), allow: [entry] });
+        const message = await migrateToKernelOwner({ ...input, dryRun }).then(() => undefined, (e: Error) => e.message);
+        expect(message).toContain(`the agent's mandate admits (IdentityRegistry ${REGISTRY}, setApprovalForAll): the agent config /etc/agent.json lists it in policy.allow.`);
+        expect(message).toContain('the agent can withdraw, alone, the owner\'s standing grant to the Safe (setApprovalForAll(Safe, false))');
+        expect(message).toContain('The owner rotates the permission to a mandate without it');
+        expect(sent).toEqual([]);
+        expect(state.owners).toEqual([EOA]);
+      }
+    }
+  });
+
+  it('and a mandate installed on the Kernel that admits it, whatever the agent config says', async () => {
+    const { input, sent } = setup({ kernelCode: '0x6001', admits: true, identity: identity(), grantEntryInstalled: true });
+    await expect(migrateToKernelOwner(input)).rejects.toThrow(
+      `the mandate installed on the Kernel ${KERNEL} (permission ${PERMISSION}, policy ${POLICY}) admits it`,
+    );
+    expect(sent).toEqual([]);
+  });
+
+  it('other entries pass, and a Safe without an identity has no grant to keep', async () => {
