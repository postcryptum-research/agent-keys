+  // preVerification 100000; paymaster 100000. maxFeePerGas: 2 × 1000 + the median of 3, 5, 7.
+  const DEPLOYED_COST = (300_000n + 150_000n + 100_000n + 100_000n) * 2_005n;
+  const FIRST_COST = (1_500_000n + 300_000n + 100_000n + 100_000n) * 2_005n;
+  const refusal = async (chain: { kernelCode: Hex; sponsorship?: [bigint, bigint] }, paymaster?: { address: Address } | { unknown: string }) => {
+    const { input, sent } = setup({ ...chain, admits: true, identity: { approved: false, nftOwner: EOA, metadata: '0x' } });
+    const message = await migrateToKernelOwner({
+      ...input, agentSignerOpSend: '/opt/agent-signer op send --agent /etc/agent.json', ...(paymaster === undefined ? {} : { paymaster }),
+    }).then(() => undefined, (e: Error) => e.message);
+    expect(sent).toEqual([]);
+    return message!;
+  };
+  const command = `\n  /opt/agent-signer op send --agent /etc/agent.json --root --target ${REGISTRY} --data ${GRANT}`;
+
+  it('within the per-operation cap and the budget left, the command carries --sponsored and says why', async () => {
+    for (const [kernelCode, cost] of [['0x6001', DEPLOYED_COST], ['0x', FIRST_COST]] as const) {
+      const message = await refusal({ kernelCode, sponsorship: [cost, cost] }, { address: PAYMASTER });
+      expect(message).toContain(`${command} --sponsored\n(--sponsored: the paymaster ${PAYMASTER} sponsors it: its maximum cost, ${cost} wei`);
+      expect(message).toContain(`within the per-operation cap of ${cost} wei and the ${cost} wei left of the account's budget`);
+    }
+  });
+
+  it('above the cap or the budget left, or where the paymaster cannot be read, it is printed without --sponsored, with the reason', async () => {
+    const cases: [{ kernelCode: Hex; sponsorship?: [bigint, bigint] }, { address: Address } | { unknown: string }, string][] = [
+      [{ kernelCode: '0x6001', sponsorship: [DEPLOYED_COST, DEPLOYED_COST - 1n] }, { address: PAYMASTER },
+        `is above the account's per-operation cap of ${DEPLOYED_COST - 1n} wei`],
+      [{ kernelCode: '0x', sponsorship: [FIRST_COST - 1n, FIRST_COST] }, { address: PAYMASTER },
+        `is above the ${FIRST_COST - 1n} wei left of the account's budget`],
+      [{ kernelCode: '0x6001' }, { address: PAYMASTER },
+        `the paymaster ${PAYMASTER} does not answer sponsorships(${KERNEL}), so whether it sponsors the account is not known (execution reverted)`],
+      [{ kernelCode: '0x6001', sponsorship: [DEPLOYED_COST, DEPLOYED_COST] }, { unknown: 'the deployments file /etc/d.json names no whitelistPaymaster' },
