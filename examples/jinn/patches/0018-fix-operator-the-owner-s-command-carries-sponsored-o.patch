+
+/**
+ * A sponsored root operation of one call from the Kernel (`op send --root --sponsored --target
+ * --data`), sized as agent-signer sizes it before a bundler is asked (agent-keys
+ * signer/crates/agent-signer/src/chain.rs, `send_raw_at` and `estimate_call_gas`):
+ *   - verificationGasLimit 300000, or 1500000 for the operation that deploys the account;
+ *   - callGasLimit: eth_estimateGas of the Kernel's `execute(0, target ‖ 0 ‖ data)` called by the
+ *     EntryPoint, plus 30%, at least 150000; before the account has code, eth_estimateGas of the
+ *     call from the account's address plus 40000 for Kernel's dispatch, plus 30%, at least 300000;
+ *   - preVerificationGas 100000; the paymaster's verification gas 100000 and no postOp;
+ *   - maxFeePerGas as alloy estimates it from the node (`estimate_eip1559_fees`): twice the next
+ *     block's base fee plus the median of the last 10 blocks' 20th-percentile priority fees that
+ *     are above zero, at least 1 wei.
+ * Without a bundler these are the operation's fields. A bundler's estimate replaces them, bounded
+ * by agent-signer at twice each (its fee at twice the node's), so with one this is the figure the
+ * bound starts from, not a ceiling.
+ */
+export async function rootOperationGas(input: {
+  readonly publicClient: Pick<PublicClient, 'getCode' | 'estimateGas' | 'getFeeHistory' | 'getBlock'>;
+  readonly kernel: Address;
+  readonly target: Address;
+  readonly data: Hex;
+}): Promise<OperationGas> {
+  const pc = input.publicClient;
+  const code = await pc.getCode({ address: input.kernel });
+  const deployed = code !== undefined && code !== '0x';
+  const withMargin = (gas: bigint, floor: bigint) => ((gas * 13n) / 10n > floor ? (gas * 13n) / 10n : floor);
+  const callGasLimit = deployed
+    ? withMargin(await pc.estimateGas({
+        account: ENTRY_POINT_V07, to: input.kernel,
+        data: encodeFunctionData({
+          abi: KERNEL_EXECUTE_ABI, functionName: 'execute',
+          args: [zeroHash, encodePacked(['address', 'uint256', 'bytes'], [input.target, 0n, input.data])],
+        }),
+      }), 150_000n)
+    : withMargin(await pc.estimateGas({ account: input.kernel, to: input.target, data: input.data }) + 40_000n, 300_000n);
+  const history = await pc.getFeeHistory({ blockCount: 10, blockTag: 'latest', rewardPercentiles: [20] });
+  const nextBaseFee = history.baseFeePerGas.at(-1) ?? 0n;
+  const baseFee = nextBaseFee !== 0n ? nextBaseFee : (await pc.getBlock()).baseFeePerGas ?? 0n;
+  const rewards = (history.reward ?? []).map((r) => r[0] ?? 0n).filter((r) => r > 0n).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
+  const n = rewards.length;
+  const median = n === 0 ? 1n : n % 2 === 0 ? (rewards[n / 2 - 1]! + rewards[n / 2]!) / 2n : rewards[(n - 1) / 2]!;
+  const gas = {
+    verificationGasLimit: deployed ? 300_000n : 1_500_000n,
+    callGasLimit,
+    preVerificationGas: 100_000n,
+    paymasterVerificationGasLimit: 100_000n,
+    paymasterPostOpGasLimit: 0n,
+    maxFeePerGas: 2n * baseFee + (median > 1n ? median : 1n),
+  };
+  const total = gas.verificationGasLimit + gas.callGasLimit + gas.preVerificationGas + gas.paymasterVerificationGasLimit + gas.paymasterPostOpGasLimit;
+  return { ...gas, maxCost: total * gas.maxFeePerGas };
+}
+
+export type Sponsorship = { readonly sponsored: true; readonly detail: string } | { readonly sponsored: false; readonly reason: string };
+
+/**
+ * Whether `paymaster`, a WhitelistPaymaster, would sponsor the Kernel's root operation that sends
+ * `data` to `target`: its maximum cost (`rootOperationGas`) must fit both the account's
+ * per-operation cap and what is left of its budget (`sponsorships(account)`), which the paymaster
+ * checks against `maxCost` at validation. Anything that cannot be read is a reason not to say so.
+ */
+export async function rootOperationSponsorship(input: {
+  readonly publicClient: Pick<PublicClient, 'readContract' | 'getCode' | 'estimateGas' | 'getFeeHistory' | 'getBlock'>;
+  readonly paymaster: Address;
+  readonly kernel: Address;
+  readonly target: Address;
+  readonly data: Hex;
+}): Promise<Sponsorship> {
+  let remaining: bigint;
+  let maxPerOp: bigint;
+  try {
+    [remaining, maxPerOp] = await input.publicClient.readContract({
+      address: input.paymaster, abi: PAYMASTER_ABI, functionName: 'sponsorships', args: [input.kernel],
+    });
+  } catch (error) {
+    return { sponsored: false, reason: `the paymaster ${input.paymaster} does not answer sponsorships(${input.kernel}), so whether it sponsors the account is not known (${firstLine(error)})` };
+  }
+  let gas: OperationGas;
+  try {
+    gas = await rootOperationGas(input);
+  } catch (error) {
+    return { sponsored: false, reason: `the operation's gas could not be estimated (${firstLine(error)})` };
+  }
+  const cost = `its maximum cost, ${gas.maxCost} wei as agent-signer sizes it (${gas.maxCost / gas.maxFeePerGas} gas at ${gas.maxFeePerGas} wei)`;
+  if (gas.maxCost > maxPerOp) {
+    return { sponsored: false, reason: `the paymaster ${input.paymaster} would refuse it: ${cost}, is above the account's per-operation cap of ${maxPerOp} wei` };
+  }
+  if (gas.maxCost > remaining) {
+    return { sponsored: false, reason: `the paymaster ${input.paymaster} would refuse it: ${cost}, is above the ${remaining} wei left of the account's budget` };
+  }
+  return { sponsored: true, detail: `the paymaster ${input.paymaster} sponsors it: ${cost}, is within the per-operation cap of ${maxPerOp} wei and the ${remaining} wei left of the account's budget` };
 }
 
