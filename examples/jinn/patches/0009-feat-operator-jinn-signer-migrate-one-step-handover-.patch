+// The migration's safety order: the Safe is never handed to a Kernel that cannot operate it.
+import { describe, expect, it, vi } from 'vitest';
+import type { Address, Hex } from 'viem';
+
+import { migrateToKernelOwner } from '../../src/signer/migrate.js';
+import { markUserOperationWallet } from '../../src/tx-retry.js';
+
+const EOA = '0x7471bE25Ec54354c8D70491Ae10bd86705fAD030' as Address;
+const KERNEL = '0xEdB645B14e2f952C5784e34949b58F0826fBc9E9' as Address;
+const SAFE = '0xd0b972a8ee7D8AB91a2e3381Eb6F10550B80E52A' as Address;
+const POLICY = '0x8347dBC3d7A71DAFDeED5975ce85638494865F73' as Address;
+const TX = `0x${'c3'.repeat(32)}` as Hex;
+
+function setup(chain: { kernelCode: Hex; admits: boolean; threshold?: bigint; owners?: Address[] }) {
+  const publicClient = {
+    async readContract(args: { functionName: string }) {
+      switch (args.functionName) {
+        case 'getOwners': return chain.owners ?? [EOA];
+        case 'getThreshold': return chain.threshold ?? 1n;
+        case 'permissionConfig': return { permissionFlag: '0x0000', signer: KERNEL, policyData: [`0x0000${POLICY.slice(2)}`] };
+        case 'isAllowed': return chain.admits;
+        default: throw new Error(`unexpected ${args.functionName}`);
+      }
+    },
+    async getCode() { return chain.kernelCode; },
+    async waitForTransactionReceipt() { return { status: 'success' }; },
+  };
+  const eoaSend = vi.fn(async () => TX);
+  const kernelSend = vi.fn(async () => TX);
+  const input = {
+    publicClient: publicClient as never,
+    agentEoaWallet: { account: { address: EOA }, chain: undefined, sendTransaction: eoaSend } as never,
+    kernelWallet: markUserOperationWallet({ account: { address: KERNEL, type: 'json-rpc' }, sendTransaction: kernelSend }) as never,
+    kernel: KERNEL,
+    permissionId: '0x6a696e6e' as Hex,
+    safeAddress: SAFE,
+  };
+  return { input, eoaSend, kernelSend };
+}
+
+describe('migrateToKernelOwner', () => {
+  it('does not hand the Safe over when the Kernel mandate does not admit it', async () => {
+    const { input, eoaSend } = setup({ kernelCode: '0x6001', admits: false });
+    await expect(migrateToKernelOwner(input)).rejects.toThrow(/does not admit .*execTransaction/);
+    expect(eoaSend).not.toHaveBeenCalled();
+  });
+
+  it('does not hand the Safe over to a Kernel that is not deployed', async () => {
+    const { input, eoaSend } = setup({ kernelCode: '0x', admits: true });
+    await expect(migrateToKernelOwner(input)).rejects.toThrow(/is not deployed/);
+    expect(eoaSend).not.toHaveBeenCalled();
+  });
+
+  it('handles 1/1 Safes only, and only Safes the EOA or the Kernel owns', async () => {
+    await expect(migrateToKernelOwner(setup({ kernelCode: '0x6001', admits: true, threshold: 2n }).input)).rejects.toThrow(/threshold 2/);
+    await expect(migrateToKernelOwner(setup({ kernelCode: '0x6001', admits: true, owners: [POLICY] }).input))
+      .rejects.toThrow(/owned by neither/);
+  });
+
+  it('a dry run sends nothing', async () => {
+    const { input, eoaSend, kernelSend } = setup({ kernelCode: '0x6001', admits: true });
+    const steps = await migrateToKernelOwner({ ...input, dryRun: true });
+    expect(steps.map((s) => [s.step, s.status])).toEqual([
+      ['kernel-approves-safe', 'not-applicable'], ['mandate-admits-safe', 'checked'], ['safe-owner', 'would'],
+      ['agent-nft', 'not-applicable'], ['attestation-key', 'not-applicable'],
+    ]);
+    expect(eoaSend).not.toHaveBeenCalled();
+    expect(kernelSend).not.toHaveBeenCalled();
+  });
+});
