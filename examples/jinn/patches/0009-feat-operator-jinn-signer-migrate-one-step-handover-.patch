+/**
+ * `jinn signer-migrate` -- hand a bootstrapped operator over to its hardware-signed Kernel
+ * account (`config.signer`, src/signer/) in one idempotent step: the Kernel proves it can sign
+ * and that its mandate admits the Safe, then the service Safe (and the fleet identity Safe, if
+ * separate) and the ERC-8004 agent NFT move from the agent EOA to the Kernel, and the EOA is
+ * published as the agent's attestation key. See src/signer/migrate.ts for the step order.
+ */
+import { readFileSync } from 'node:fs';
+import { parseArgs } from 'node:util';
+import { getAddress, type Address, type Hex } from 'viem';
+import { privateKeyToAccount } from 'viem/accounts';
+
+import { COMMON_FLAGS, type CommandContext, type CommandModule } from '../command.js';
+import { emitResult } from '../output.js';
+import { emitEnvelope } from '../../errors/envelope.js';
+import { ensureConfirmed } from '../action.js';
+import { createCliSignerContext, pickPrimaryMechService } from '../execution-context.js';
+import { walletPrivateKeyAtIndex } from '../../earning/wallet.js';
+import { createJinnWalletClient } from '../../earning/viem-clients.js';
+import { agentSignerConfigOf, createAgentSignerWalletClient } from '../../signer/index.js';
+import { migrateToKernelOwner, type MigrationStep } from '../../signer/migrate.js';
+
+const EXAMPLE = 'jinn signer-migrate --dry-run';
+
+async function run(ctx: CommandContext): Promise<void> {
+  let parsed;
+  try {
+    parsed = parseArgs({
+      args: ctx.argv,
+      options: {
+        ...COMMON_FLAGS,
+        'dry-run': { type: 'boolean', default: false },
+        yes: { type: 'boolean', default: false },
+      },
+      allowPositionals: false,
+    });
+  } catch (err) {
+    emitEnvelope(
+      { code: 'invalid_invocation', message: err instanceof Error ? err.message : String(err), exampleCli: EXAMPLE, details: { field: 'flags' } },
+      { writer: ctx.writer, exit: ctx.exit },
+    );
+    return;
+  }
+  const dryRun = parsed.values['dry-run'] as boolean;
+  if (!dryRun && !ensureConfirmed(ctx, { yes: parsed.values.yes as boolean, dryRun: false })) return;
+
+  const built = await createCliSignerContext({ argv: ctx.argv, env: ctx.env });
+  if (!built.ok) {
+    emitEnvelope(built.envelope, { writer: ctx.writer, exit: ctx.exit });
+    return;
+  }
+  const { config, networkChain, fleetState, mnemonic, publicClient } = built.ctx;
+  if (config.signer === undefined) {
+    emitEnvelope(
+      {
+        code: 'invalid_invocation',
+        message: 'No `signer` section in the config: there is no Kernel account to migrate to.',
+        hint: 'Add "signer": { "kind": "agent-signer", "bin", "config", "account" } to the config (src/signer/config.ts).',
+        exampleCli: EXAMPLE,
+        details: { field: 'signer' },
+      },
+      { writer: ctx.writer, exit: ctx.exit },
+    );
+    return;
+  }
+  const service = pickPrimaryMechService(fleetState.services);
+  if (service?.safe_address == null) {
+    emitEnvelope(
+      { code: 'bootstrap_incomplete', message: 'No complete service with a Safe to migrate.', exampleCli: 'jinn bootstrap --json', details: { field: 'fleet' } },
+      { writer: ctx.writer, exit: ctx.exit },
+    );
+    return;
+  }
+
+  try {
+    const agentConfig = JSON.parse(readFileSync(config.signer.config, 'utf8')) as { permissionId?: string };
+    if (typeof agentConfig.permissionId !== 'string') throw new Error(`${config.signer.config} has no permissionId`);
+    const agentEoaWallet = createJinnWalletClient(config.rpcUrl, networkChain,
+      privateKeyToAccount(walletPrivateKeyAtIndex(mnemonic, service.index) as Hex));
+    const kernelWallet = createAgentSignerWalletClient({
+      rpcUrl: config.rpcUrl, chain: publicClient.chain!, signer: agentSignerConfigOf(config.signer),
+    });
+    const kernel = getAddress(config.signer.account);
+
+    // The service Safe, then the fleet identity Safe when it is a different one (same agent EOA).
+    const targets: { label: string; safe: Address; agentId: string | null; registry: string | null }[] = [
+      { label: 'service', safe: getAddress(service.safe_address), agentId: service.agent_id ?? null, registry: service.identity_registry_address ?? null },
+    ];
+    const fleetSafe = fleetState.fleet_safe_address;
+    if (fleetSafe != null && getAddress(fleetSafe) !== targets[0]!.safe) {
+      targets.push({ label: 'fleet identity', safe: getAddress(fleetSafe), agentId: fleetState.fleet_agent_id ?? null, registry: fleetState.fleet_identity_registry ?? null });
+    }
+
+    const results: { label: string; safe: Address; steps: readonly MigrationStep[] }[] = [];
+    for (const target of targets) {
+      const steps = await migrateToKernelOwner({
+        publicClient: publicClient as never,
+        agentEoaWallet: agentEoaWallet as never,
+        kernelWallet,
+        kernel,
+        permissionId: agentConfig.permissionId as Hex,
+        safeAddress: target.safe,
+        ...(target.agentId !== null && target.registry !== null
+          ? { identityRegistry: getAddress(target.registry), agentId: BigInt(target.agentId) }
+          : {}),
+        dryRun,
+      });
+      results.push({ label: target.label, safe: target.safe, steps });
+    }
+
+    const payload = { schemaVersion: 1 as const, dryRun, kernel, agentEoa: agentEoaWallet.account.address, safes: results };
+    emitResult(
+      payload,
+      () => [
+        `${dryRun ? 'Migration plan' : 'Migrated'}: agent EOA ${payload.agentEoa} -> Kernel ${kernel}`,
+        ...results.flatMap((r) => [
+          `  ${r.label} Safe ${r.safe}`,
+          ...r.steps.map((s) => `    ${s.step.padEnd(22)} ${s.status}${s.txHash ? `  ${s.txHash}` : ''}${s.detail ? `  (${s.detail})` : ''}`),
+        ]),
+      ].join('\n'),
+      { json: Boolean(parsed.values.json), human: Boolean(parsed.values.human), writer: ctx.writer, stdoutIsTty: ctx.stdoutIsTty, noColor: Boolean(ctx.env['NO_COLOR']) },
+    );
+    ctx.exit(0);
+  } catch (e) {
+    emitEnvelope(
+      {
+        code: 'fatal',
+        message: e instanceof Error ? e.message : String(e),
+        hint: 'Every step checks the chain first: fix the cause and re-run; completed steps are skipped.',
+        exampleCli: EXAMPLE,
+        details: { cause: e instanceof Error ? e.message : String(e) },
+      },
+      { writer: ctx.writer, exit: ctx.exit },
+    );
+  }
+}
+
+const command: CommandModule = {
+  name: 'signer-migrate',
+  summary: 'Hand the operator over to its hardware-signed Kernel account (config.signer)',
+  helpText: `Usage: jinn signer-migrate [--dry-run] [--yes] [--json|--human] [--config <path>] [--password-fd <fd>]
+
+Moves the service Safe (and the fleet identity Safe, if separate) and the
+ERC-8004 agent NFT from the keystore agent EOA to the Kernel account named in
+the config's \`signer\` section, after the Kernel has signed once through
+agent-signer and its mandate is checked to admit the Safe. The agent EOA
+stays as the agent's attestation key (off-chain documents only) and is
+published as \`jinn.attestationKey\`.
+
+Idempotent: every step reads the chain first; re-run after an interruption.
+Run with the daemon stopped. The agent EOA pays the gas of the two handover
+transactions; the Kernel pays its own.
+
+Examples:
+  jinn signer-migrate --dry-run --human
+  jinn signer-migrate --yes
+`,
+  run,
+};
+export default command;
