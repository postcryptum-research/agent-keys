diff --git a/operator/src/signer/migrate.ts b/operator/src/signer/migrate.ts
new file mode 100644
index 000000000..d974b9374
--- /dev/null
+++ b/operator/src/signer/migrate.ts
@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: MIT
+
+// One-step migration of a bootstrapped operator to a hardware-signed Kernel owner
+// (`jinn signer-migrate`). Every step reads the chain first and is skipped when already done, so
+// the command is safe to re-run after an interruption.
+//
+//   1. kernel-approves-safe   the Kernel calls IdentityRegistry.setApprovalForAll(Safe, true)
+//                             through agent-signer -- deploying the account if needed and, above
+//                             all, PROVING that the hardware key can sign for it under its
+//                             mandate before anything is handed over to it;
+//   2. mandate-admits-safe    the Kernel's AgentPolicy admits (Safe, execTransaction): without it
+//                             the agent could not drive the Safe after the swap;
+//   3. safe-owner             the agent EOA swaps itself out of the Safe for the Kernel
+//                             (Safe.execTransaction(swapOwner) with a pre-validated signature);
+//   4. agent-nft              the agent EOA transfers the ERC-8004 agent NFT to the Kernel;
+//   5. attestation-key        the Kernel publishes the EOA as jinn.attestationKey;
+//   6. eoa-has-no-authority   final check: the EOA owns neither the Safe nor the NFT.
+//
+// Steps 1-2 precede the swap on purpose: the Safe is never handed to an address that cannot
+// operate it.
+import {
+  encodeFunctionData,
+  getAddress,
+  parseAbi,
+  zeroAddress,
+  type Address,
+  type Hex,
+  type PublicClient,
+  type WalletClient,
+} from 'viem';
+
+import { viemSendTransactionWithRetry, type TxRetryWalletClient } from '../tx-retry.js';
+import { assertAgentEoaHasNoAuthority, ensureAttestationKeyBinding, readAttestationKey } from './attestation.js';
+
+const SENTINEL_OWNERS = '0x0000000000000000000000000000000000000001' as Address;
+const EXEC_TRANSACTION_SELECTOR = '0x6a761202' as Hex;
+
+const SAFE_ABI = parseAbi([
+  'function getOwners() view returns (address[])',
+  'function getThreshold() view returns (uint256)',
+  'function swapOwner(address prevOwner, address oldOwner, address newOwner)',
+  'function execTransaction(address to, uint256 value, bytes data, uint8 operation, uint256 safeTxGas, uint256 baseGas, uint256 gasPrice, address gasToken, address refundReceiver, bytes signatures) payable returns (bool)',
+]);
+const REGISTRY_ABI = parseAbi([
+  'function ownerOf(uint256 tokenId) view returns (address)',
+  'function transferFrom(address from, address to, uint256 tokenId)',
+  'function setApprovalForAll(address operator, bool approved)',
+  'function isApprovedForAll(address owner, address operator) view returns (bool)',
+]);
+const KERNEL_ABI = parseAbi([
+  'function permissionConfig(bytes4 pId) view returns ((bytes2 permissionFlag, address signer, bytes22[] policyData))',
+]);
+const POLICY_ABI = parseAbi([
+  'function isAllowed(address account, bytes32 id, address target, bytes4 selector) view returns (bool)',
+]);
+
+export type MigrationStepName =
+  | 'kernel-approves-safe'
+  | 'mandate-admits-safe'
+  | 'safe-owner'
+  | 'agent-nft'
+  | 'attestation-key'
+  | 'eoa-has-no-authority';
+
+export interface MigrationStep {
+  readonly step: MigrationStepName;
+  /** done: this run changed it; already: it was so; would: --dry-run; checked: a pure check passed. */
+  readonly status: 'done' | 'already' | 'would' | 'checked' | 'not-applicable';
+  readonly txHash?: Hex;
+  readonly detail?: string;
+}
+
+export interface MigrationInput {
+  readonly publicClient: PublicClient;
+  /** The agent EOA (keystore) -- the Safe's and the NFT's current owner. */
+  readonly agentEoaWallet: WalletClient;
+  /** The Kernel account through agent-signer (`createAgentSignerWalletClient`). */
+  readonly kernelWallet: WalletClient;
+  readonly kernel: Address;
+  /** The agent permission the Kernel's agent key signs under (`permissionId` of its config). */
+  readonly permissionId: Hex;
+  readonly safeAddress: Address;
+  /** The ERC-8004 identity; without it steps 1, 4 and 5 do not apply. */
+  readonly identityRegistry?: Address;
+  readonly agentId?: bigint;
+  readonly dryRun?: boolean;
+}
+
+async function send(wallet: WalletClient, publicClient: PublicClient, to: Address, data: Hex, logicalTx: string): Promise<Hex> {
+  const account = wallet.account;
+  if (account === undefined) throw new Error(`${logicalTx}: the wallet has no account`);
+  const hash = await viemSendTransactionWithRetry(
+    wallet as unknown as TxRetryWalletClient,
+    publicClient,
+    { account, to, data, value: 0n, chain: wallet.chain },
+    { logicalTx },
+  );
+  const receipt = await publicClient.waitForTransactionReceipt({ hash });
+  if (receipt.status !== 'success') throw new Error(`${logicalTx} reverted (tx ${hash})`);
+  return hash;
+}
+
+export async function migrateToKernelOwner(input: MigrationInput): Promise<readonly MigrationStep[]> {
+  const pc = input.publicClient;
+  const eoa = getAddress(input.agentEoaWallet.account!.address);
+  const kernel = getAddress(input.kernel);
+  const safe = getAddress(input.safeAddress);
+  const identity = input.identityRegistry !== undefined && input.agentId !== undefined
+    ? { registry: getAddress(input.identityRegistry), agentId: input.agentId }
+    : undefined;
+  const steps: MigrationStep[] = [];
+
+  // Preconditions: a 1/1 Safe owned by the EOA (or already by the Kernel).
+  const owners = (await pc.readContract({ address: safe, abi: SAFE_ABI, functionName: 'getOwners' })).map((o) => getAddress(o));
+  const threshold = await pc.readContract({ address: safe, abi: SAFE_ABI, functionName: 'getThreshold' });
+  if (!owners.includes(eoa) && !owners.includes(kernel)) {
+    throw new Error(`the Safe ${safe} is owned by neither the agent EOA ${eoa} nor the Kernel ${kernel}: ${owners.join(', ')}`);
+  }
+  if (threshold !== 1n) throw new Error(`the Safe ${safe} has threshold ${threshold}; this migration handles 1/1 Safes only`);
+
+  // 1. The Kernel signs once, before it receives anything.
+  if (identity === undefined) {
+    steps.push({ step: 'kernel-approves-safe', status: 'not-applicable', detail: 'no ERC-8004 identity' });
+  } else if (await pc.readContract({ address: identity.registry, abi: REGISTRY_ABI, functionName: 'isApprovedForAll', args: [kernel, safe] })) {
+    steps.push({ step: 'kernel-approves-safe', status: 'already' });
+  } else if (input.dryRun) {
+    steps.push({ step: 'kernel-approves-safe', status: 'would' });
+  } else {
+    const txHash = await send(input.kernelWallet, pc, identity.registry,
+      encodeFunctionData({ abi: REGISTRY_ABI, functionName: 'setApprovalForAll', args: [safe, true] }), 'signer-migrate.approve-safe');
+    steps.push({ step: 'kernel-approves-safe', status: 'done', txHash });
+  }
+
+  // 2. The mandate must let the agent drive the Safe once it owns it.
+  const code = await pc.getCode({ address: kernel });
+  if (code === undefined || code === '0x') {
+    if (!input.dryRun) {
+      throw new Error(`the Kernel ${kernel} is not deployed: its first operation (step 1) deploys it; without an ERC-8004 identity, send any agent operation first`);
+    }
+    steps.push({ step: 'mandate-admits-safe', status: 'would', detail: 'the Kernel is not deployed yet' });
+  } else {
+    const config = await pc.readContract({ address: kernel, abi: KERNEL_ABI, functionName: 'permissionConfig', args: [input.permissionId] });
+    const policyData = config.policyData[0];
+    if (config.signer === zeroAddress || policyData === undefined) {
+      throw new Error(`permission ${input.permissionId} is not installed on the Kernel ${kernel}`);
+    }
+    const policy = getAddress(`0x${policyData.slice(-40)}`);
+    const id32 = `${input.permissionId}${'0'.repeat(56)}` as Hex;
+    const admits = await pc.readContract({
+      address: policy, abi: POLICY_ABI, functionName: 'isAllowed', args: [kernel, id32, safe, EXEC_TRANSACTION_SELECTOR],
+    });
+    if (!admits) {
+      throw new Error(`the Kernel's mandate (permission ${input.permissionId}, policy ${policy}) does not admit ${safe}.execTransaction: install one that does before handing the Safe over`);
+    }
+    steps.push({ step: 'mandate-admits-safe', status: 'checked' });
+  }
+
+  // 3. Hand the Safe over.
+  if (owners.includes(kernel) && !owners.includes(eoa)) {
+    steps.push({ step: 'safe-owner', status: 'already' });
+  } else if (input.dryRun) {
+    steps.push({ step: 'safe-owner', status: 'would' });
+  } else {
+    const at = owners.indexOf(eoa);
+    const prevOwner = at === 0 ? SENTINEL_OWNERS : owners[at - 1]!;
+    const swap = encodeFunctionData({ abi: SAFE_ABI, functionName: 'swapOwner', args: [prevOwner, eoa, kernel] });
+    // Pre-validated signature: r = owner, s = 0, v = 1 -- valid because msg.sender is that owner.
+    const signature = `0x${eoa.slice(2).toLowerCase().padStart(64, '0')}${'0'.repeat(64)}01` as Hex;
+    const txHash = await send(input.agentEoaWallet, pc, safe, encodeFunctionData({
+      abi: SAFE_ABI, functionName: 'execTransaction',
+      args: [safe, 0n, swap, 0, 0n, 0n, 0n, zeroAddress, zeroAddress, signature],
+    }), 'signer-migrate.swap-owner');
+    steps.push({ step: 'safe-owner', status: 'done', txHash });
+  }
+
+  // 4. Hand the agent NFT over.
+  if (identity === undefined) {
+    steps.push({ step: 'agent-nft', status: 'not-applicable', detail: 'no ERC-8004 identity' });
+  } else {
+    const nftOwner = getAddress(await pc.readContract({ address: identity.registry, abi: REGISTRY_ABI, functionName: 'ownerOf', args: [identity.agentId] }));
+    if (nftOwner === kernel) {
+      steps.push({ step: 'agent-nft', status: 'already' });
+    } else if (nftOwner !== eoa) {
+      throw new Error(`agent NFT ${identity.agentId} belongs to ${nftOwner}, neither the agent EOA nor the Kernel`);
+    } else if (input.dryRun) {
+      steps.push({ step: 'agent-nft', status: 'would' });
+    } else {
+      const txHash = await send(input.agentEoaWallet, pc, identity.registry,
+        encodeFunctionData({ abi: REGISTRY_ABI, functionName: 'transferFrom', args: [eoa, kernel, identity.agentId] }), 'signer-migrate.agent-nft');
+      steps.push({ step: 'agent-nft', status: 'done', txHash });
+    }
+  }
+
+  // 5. Publish the EOA as the agent's attestation key.
+  if (identity === undefined) {
+    steps.push({ step: 'attestation-key', status: 'not-applicable', detail: 'no ERC-8004 identity' });
+  } else if (input.dryRun) {
+    const current = await readAttestationKey({ publicClient: pc, identityRegistry: identity.registry, agentId: identity.agentId });
+    steps.push({ step: 'attestation-key', status: current === eoa ? 'already' : 'would' });
+  } else {
+    const binding = await ensureAttestationKeyBinding({
+      publicClient: pc, wallet: input.kernelWallet, identityRegistry: identity.registry, agentId: identity.agentId, attestationAddress: eoa,
+    });
+    steps.push(binding.status === 'published'
+      ? { step: 'attestation-key', status: 'done', txHash: binding.txHash }
+      : { step: 'attestation-key', status: 'already' });
+  }
+
+  // 6. Nothing left with the EOA but document signing.
+  if (!input.dryRun) {
+    await assertAgentEoaHasNoAuthority({
+      publicClient: pc, agentEoa: eoa, safeAddress: safe,
+      ...(identity === undefined ? {} : { identityRegistry: identity.registry, agentId: identity.agentId }),
+    });
+    steps.push({ step: 'eoa-has-no-authority', status: 'checked' });
+  }
+  return steps;
+}
