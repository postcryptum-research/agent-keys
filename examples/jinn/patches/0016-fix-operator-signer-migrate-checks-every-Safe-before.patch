+    steps.push({ step: 'agent-nft', status: 'done', txHash });
   }
 
   // 5. Publish the EOA as the agent's attestation key. The Kernel's agent key signs here, under
@@ -412,3 +449,51 @@ export async function migrateToKernelOwner(input: MigrationInput): Promise<reado
   }
