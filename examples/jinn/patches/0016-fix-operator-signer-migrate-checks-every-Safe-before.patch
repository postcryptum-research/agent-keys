+
+/** What `jinn signer-migrate` prints (`--json`): every Safe it handed over, or would, in order. */
+export interface MigrationOutput {
+  readonly schemaVersion: 1;
+  readonly dryRun: boolean;
+  readonly kernel: Address;
+  readonly agentEoa: Address;
+  readonly safes: readonly { readonly label: MigrationTarget['label']; readonly safe: Address; readonly steps: readonly MigrationStep[] }[];
+}
+
+/**
+ * `jinn signer-migrate` over its targets (`migrationTargets`): every Safe's checks first
+ * (`preflight`: owners, threshold, modules, guard, fallback handler, the owner's grant, the
+ * mandate, the agent NFT where there is one and the agent proof where there is none), then each
+ * Safe's migration, which reads them again right before its handover. A refusal on any Safe
+ * comes before the first changes hands.
+ */
+export async function migrateTargets(
+  input: Omit<MigrationInput, 'safeAddress' | 'identityRegistry' | 'agentId'>,
+  targets: readonly MigrationTarget[],
+): Promise<MigrationOutput> {
+  const of = (target: MigrationTarget): MigrationInput => ({
+    ...input,
+    safeAddress: target.safeAddress,
+    ...(target.identityRegistry === undefined || target.agentId === undefined
+      ? {}
+      : { identityRegistry: target.identityRegistry, agentId: target.agentId }),
+  });
+  const named = async <T>(target: MigrationTarget, when: string, run: () => Promise<T>): Promise<T> => {
+    try {
+      return await run();
+    } catch (error) {
+      throw new Error(`the ${target.label} Safe ${target.safeAddress}${when}: ${error instanceof Error ? error.message : String(error)}`);
+    }
+  };
+  for (const target of targets) await named(target, ', read before any Safe changes hands', () => preflight(of(target)));
+  const safes: { label: MigrationTarget['label']; safe: Address; steps: readonly MigrationStep[] }[] = [];
+  for (const target of targets) {
+    safes.push({ label: target.label, safe: target.safeAddress, steps: await named(target, '', () => migrateToKernelOwner(of(target))) });
+  }
+  return {
+    schemaVersion: 1,
+    dryRun: input.dryRun === true,
+    kernel: getAddress(input.kernel),
+    agentEoa: getAddress(input.agentEoaWallet.account!.address),
+    safes,
+  };
+}
