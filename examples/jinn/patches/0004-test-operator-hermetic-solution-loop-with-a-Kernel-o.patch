diff --git a/operator/test/hermetic/full-loop-kernel-owner.test.ts b/operator/test/hermetic/full-loop-kernel-owner.test.ts
new file mode 100644
index 000000000..1e23f501d
--- /dev/null
+++ b/operator/test/hermetic/full-loop-kernel-owner.test.ts
@@ -0,0 +1,250 @@
+/**
+ * Hermetic loop with a hardware-signed Safe owner (src/signer/, TPM_sign).
+ *
+ * The same production solution loop as `full-loop.test.ts` -- bootstrap -> claim -> execute ->
+ * deliver -> solution settlement on the committed snapshot -- except that the service Safe's
+ * owner is moved from the agent EOA to a Kernel (ERC-4337) account before the daemon starts,
+ * and the daemon's venue broadcaster is `kernelSafeBroadcasterFactory`: every Safe transaction
+ * of the loop is one UserOperation signed by an agent key held in hardware (TPM / Secure Enclave
+ * / TROPIC01) through the `agent-signer` CLI, and judged on-chain by the account's AgentPolicy
+ * against a mandate that admits exactly this loop's three calls.
+ *
+ * The ERC-4337 side is installed on the snapshot from a committed bytecode fixture (EntryPoint
+ * v0.7, Kernel v3.3 + factory, TPM_sign's P256Validator / P256Signer / AgentPolicy /
+ * SafeNonceAssert, Solady's P-256 verifier) -- no live RPC. `agent-signer` submits
+ * `handleOps` itself from a funded Anvil key (no bundler).
+ *
+ * SKIP-CLEAN unless both are set:
+ *   TPM_SIGN_AGENT_SIGNER  path to the agent-signer binary (with the agent key's backend)
+ *   TPM_SIGN_KEYS          a TPM_sign agent config whose `agent`, `agentPublicKey` and
+ *                          `ownerPublicKey` are used (the owner key itself is never opened)
+ * With a TROPIC01 / TPM agent key the process needs access to that device.
+ */
+
+import { existsSync, mkdtempSync, readFileSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { execFileSync } from 'node:child_process';
+import { describe, it, expect } from 'vitest';
+import { privateKeyToAccount } from 'viem/accounts';
+import { base } from 'viem/chains';
+import {
+  createWalletClient,
+  decodeEventLog,
+  encodeFunctionData,
+  http,
+  parseAbi,
+  parseAbiItem,
+  type Address,
+  type Hex,
+  type PublicClient,
+} from 'viem';
+import {
+  setupAnvilFixtureFromState,
+  bootstrapStakedOperator,
+  deployMinimalV3Stack,
+  startDaemon,
+  startMockIpfsServer,
+  postPredictionV1Task,
+  waitForDaemonClaim,
+  waitForDelivery,
+  waitForSolutionSettlement,
+  ANVIL_PRIVATE_KEYS,
+  type HarnessSelector,
+} from '../e2e/_daemon-harness-helpers.js';
+import { jsonRpc as anvilJsonRpc } from '../_support/chain/anvil.js';
+import {
+  createBroadcastLock,
+  createSubmissionLedger,
+  openVenueState,
+} from '@jinn-network/marketplace-venue-base';
+import {
+  createKernelSafeBroadcaster,
+  kernelSafeBroadcasterFactory,
+  ENTRY_POINT_V07,
+} from '../../src/signer/kernel-safe-broadcaster.js';
+import { AgentSignerError, type AgentSignerConfig } from '../../src/signer/agent-signer-cli.js';
+
+const TEST_DIR = dirname(fileURLToPath(import.meta.url));
+const SNAPSHOT_STATE = resolve(TEST_DIR, '..', '_support', 'fixtures', 'anvil-base-v3-state', 'state.json');
+const AA_CODE = resolve(TEST_DIR, '..', '_support', 'fixtures', 'tpm-sign-aa-code.json');
+
+const AGENT_SIGNER = process.env['TPM_SIGN_AGENT_SIGNER'];
+const KEYS = process.env['TPM_SIGN_KEYS'];
+const READY = existsSync(SNAPSHOT_STATE) && AGENT_SIGNER !== undefined && KEYS !== undefined;
+const describeMaybe = READY ? describe : describe.skip;
+
+const HARNESS: HarnessSelector = 'prediction-v1-baseline';
+const PROVENANCE = {
+  instanceId: 'jinn__hermetic-envelope-provenance',
+  repo: 'Jinn-Network/mono',
+  baseCommit: '1'.repeat(40),
+};
+
+const SAFE_ABI = parseAbi([
+  'function getOwners() view returns (address[])',
+  'function swapOwner(address prevOwner, address oldOwner, address newOwner)',
+  'function addOwnerWithThreshold(address owner, uint256 _threshold)',
+  'function execTransaction(address to, uint256 value, bytes data, uint8 operation, uint256 safeTxGas, uint256 baseGas, uint256 gasPrice, address gasToken, address refundReceiver, bytes signatures) payable returns (bool)',
+]);
+const USER_OPERATION_EVENT = parseAbiItem(
+  'event UserOperationEvent(bytes32 indexed userOpHash, address indexed sender, address indexed paymaster, uint256 nonce, bool success, uint256 actualGasCost, uint256 actualGasUsed)',
+);
+const SENTINEL_OWNERS = '0x0000000000000000000000000000000000000001' as Address;
+// The three Safe calls of one solution cycle (router.claimTask, mech.deliver,
+// router.claimSolutionDelivery) -- the whole mandate besides Safe.execTransaction itself.
+const SEL = { execTransaction: '0x6a761202', claimTask: '0xb0ea3103', deliver: '0x6f6885bb', claimSolutionDelivery: '0xc47dda39' };
+
+interface AaCode { contracts: Record<string, { address: Address; code: Hex }> }
+
+async function installAccountAbstraction(rpcUrl: string): Promise<Record<string, Address>> {
+  const fixture = JSON.parse(readFileSync(AA_CODE, 'utf8')) as AaCode;
+  const addresses: Record<string, Address> = {};
+  for (const [name, { address, code }] of Object.entries(fixture.contracts)) {
+    await anvilJsonRpc(rpcUrl, 'anvil_setCode', [address, code]);
+    addresses[name] = address;
+  }
+  return addresses;
+}
+
+/** Ask the Safe's current EOA owner to hand ownership to `newOwner` (pre-validated v = 1). */
+async function moveSafeOwnership(
+  publicClient: PublicClient, rpcUrl: string, safe: Address, ownerKey: Hex, newOwner: Address,
+): Promise<void> {
+  const owner = privateKeyToAccount(ownerKey);
+  const wallet = createWalletClient({ account: owner, chain: base, transport: http(rpcUrl) });
+  const swap = encodeFunctionData({ abi: SAFE_ABI, functionName: 'swapOwner', args: [SENTINEL_OWNERS, owner.address, newOwner] });
+  const signature = `0x${owner.address.slice(2).toLowerCase().padStart(64, '0')}${'0'.repeat(64)}01` as Hex;
+  const hash = await wallet.writeContract({
+    address: safe, abi: SAFE_ABI, functionName: 'execTransaction',
+    args: [safe, 0n, swap, 0, 0n, 0n, 0n, '0x0000000000000000000000000000000000000000', '0x0000000000000000000000000000000000000000', signature],
+  });
+  const receipt = await publicClient.waitForTransactionReceipt({ hash });
+  if (receipt.status !== 'success') throw new Error(`swapOwner to ${newOwner} reverted (tx ${hash})`);
+}
+
+describeMaybe('hermetic daemon solution loop, Safe owned by a hardware-signed Kernel account', () => {
+  it(
+    'claim -> deliver -> solution settlement go through agent-signer; the mandate refuses Safe self-administration',
+    async () => {
+      const fixture = await setupAnvilFixtureFromState(SNAPSHOT_STATE);
+      const mockIpfs = await startMockIpfsServer();
+      let running: Awaited<ReturnType<typeof startDaemon>> | undefined;
+      try {
+        const operator = await bootstrapStakedOperator(fixture);
+        const CREATOR_PRIV_KEY = ANVIL_PRIVATE_KEYS[0]!;
+        await anvilJsonRpc(fixture.anvil.rpcUrl, 'anvil_setBalance', [
+          privateKeyToAccount(CREATOR_PRIV_KEY).address, '0x56bc75e2d63100000',
+        ]);
+        const v3Env = await deployMinimalV3Stack(fixture, operator, CREATOR_PRIV_KEY);
+        await fixture.anvil.mineBlocks(130);
+
+        // ── The ERC-4337 side and the agent's account ─────────────────────────
+        const aa = await installAccountAbstraction(fixture.anvil.rpcUrl);
+        const work = mkdtempSync(join(tmpdir(), 'kernel-owner-'));
+        // The hot wallet agent-signer submits handleOps from (no bundler on Anvil).
+        const gasKey = `0x${'0'.repeat(62)}9a` as Hex;
+        writeFileSync(join(work, 'gas.key'), gasKey);
+        writeFileSync(join(work, '.env'), `RPC_URL=${fixture.anvil.rpcUrl}\nGAS_WALLET_KEYFILE=${join(work, 'gas.key')}\n`);
+        await anvilJsonRpc(fixture.anvil.rpcUrl, 'anvil_setBalance', [privateKeyToAccount(gasKey).address, '0x56bc75e2d63100000']);
+        writeFileSync(join(work, 'deployments.json'), JSON.stringify({
+          chainId: base.id,
+          entryPoint: aa['entryPoint'], kernel: aa['kernel'], kernelFactory: aa['kernelFactory'],
+          p256Validator: aa['p256Validator'], p256Signer: aa['p256Signer'], agentPolicy: aa['agentPolicy'],
+          safeNonceAssert: aa['safeNonceAssert'], demoCounter: '0x0000000000000000000000000000000000000000',
+        }));
+        const keys = JSON.parse(readFileSync(KEYS!, 'utf8')) as Record<string, unknown>;
+        const agentConfig: Record<string, unknown> = {
+          deployments: join(work, 'deployments.json'),
+          owner: keys['owner'],
+          ownerPublicKey: keys['ownerPublicKey'],
+          agent: keys['agent'],
+          agentPublicKey: keys['agentPublicKey'],
+          permissionId: '0x6a696e6e', // "jinn"
+          salt: '0x0',
+          policy: {
+            allow: [
+              { target: operator.safeAddress, selector: SEL.execTransaction },
+              { target: v3Env.routerAddress, selector: SEL.claimTask },
+              { target: v3Env.mockMechAddress, selector: SEL.deliver },
+              { target: v3Env.routerAddress, selector: SEL.claimSolutionDelivery },
+            ],
+            maxValuePerOp: '1',
+            budget: '1000000000000000000', // gas of the account's own operations
+            validUntil: 4_000_000_000,
+          },
+        };
+        const configPath = join(work, 'agent.json');
+        writeFileSync(configPath, JSON.stringify(agentConfig, null, 2));
+        const initData = execFileSync(AGENT_SIGNER!, ['account', 'init-data', '--agent', configPath, '--env-file', join(work, '.env')], { encoding: 'utf8' });
+        // Not pinned in the config: agent-signer derives it from ownerPublicKey + the first
+        // permission, and its first operation deploys it (initCode).
+        const kernel = initData.match(/^account:\s+(0x[0-9a-fA-F]{40})/m)![1] as Address;
+        await anvilJsonRpc(fixture.anvil.rpcUrl, 'anvil_setBalance', [kernel, '0x8ac7230489e80000']); // 10 ETH
+
+        // ── The Safe changes hands: agent EOA -> Kernel ──────────────────────
+        await moveSafeOwnership(fixture.publicClient as never, fixture.anvil.rpcUrl, operator.safeAddress, operator.agentPrivateKey, kernel);
+        const owners = await fixture.publicClient.readContract({ address: operator.safeAddress, abi: SAFE_ABI, functionName: 'getOwners' });
+        expect(owners).toEqual([kernel]);
+
+        const signer: AgentSignerConfig = {
+          bin: AGENT_SIGNER!, configPath, account: kernel, envFile: join(work, '.env'), timeoutMs: 240_000,
+        };
+        running = await startDaemon(fixture, operator, HARNESS, mockIpfs.baseUrl, v3Env, mockIpfs.baseUrl, {
+          enableComposition: true,
+          safeBroadcaster: kernelSafeBroadcasterFactory(signer),
+        });
+
+        const posted = await postPredictionV1Task(fixture, operator, CREATOR_PRIV_KEY, mockIpfs, v3Env, { provenance: PROVENANCE });
+        expect(posted.taskId).toBeGreaterThan(0n);
+        const claim = await waitForDaemonClaim(fixture, posted, operator, v3Env);
+        const delivered = await waitForDelivery(fixture, claim, v3Env, mockIpfs);
+        const settlement = await waitForSolutionSettlement(fixture, claim, operator, v3Env);
+        expect(settlement.requestId.toLowerCase()).toBe(claim.requestId.toLowerCase());
+        expect(settlement.operator.toLowerCase()).toBe(operator.safeAddress.toLowerCase());
+
+        // Each of the three went in as a UserOperation of the Kernel, through the EntryPoint.
+        console.log(`[kernel-owner] Safe ${operator.safeAddress} owned by Kernel ${kernel}; `
+          + `claim ${claim.txHash}, deliver ${delivered.deliveryTxHash}, settle ${settlement.txHash}`);
+        for (const hash of [claim.txHash, delivered.deliveryTxHash as Hex, settlement.txHash]) {
+          const tx = await fixture.publicClient.getTransaction({ hash });
+          expect(tx.to?.toLowerCase()).toBe(ENTRY_POINT_V07.toLowerCase());
+          const receipt = await fixture.publicClient.getTransactionReceipt({ hash });
+          const ops = receipt.logs.flatMap((log) => {
+            try {
+              return [decodeEventLog({ abi: [USER_OPERATION_EVENT], data: log.data, topics: log.topics as [Hex, ...Hex[]] })];
+            } catch { return []; }
+          });
+          expect(ops.some((op) => op.args.sender.toLowerCase() === kernel.toLowerCase() && op.args.success)).toBe(true);
+        }
+
+        // ── A compromised agent host: the mandate refuses Safe self-administration ──
+        const state = openVenueState(join(work, 'probe-venue.db'));
+        try {
+          const probe = createKernelSafeBroadcaster({
+            chainId: base.id, safeAddress: operator.safeAddress, publicClient: fixture.publicClient as never,
+            ledger: createSubmissionLedger(state), lock: createBroadcastLock(state), signer,
+          });
+          const addOwner = encodeFunctionData({
+            abi: SAFE_ABI, functionName: 'addOwnerWithThreshold', args: ['0x000000000000000000000000000000000000bEEF', 1n],
+          });
+          const refused = await probe.execute({ to: operator.safeAddress, value: 0n, data: addOwner, logicalTx: 'probe.addOwner' })
+            .catch((e: unknown) => e);
+          expect(refused).toBeInstanceOf(AgentSignerError);
+          expect((refused as AgentSignerError).kind).toBe('policy-denied');
+          console.log('[kernel-owner] Safe.addOwnerWithThreshold through the Kernel: policy-denied');
+        } finally {
+          state.close();
+        }
+        const ownersAfter = await fixture.publicClient.readContract({ address: operator.safeAddress, abi: SAFE_ABI, functionName: 'getOwners' });
+        expect(ownersAfter).toEqual([kernel]);
+      } finally {
+        if (running) { try { await running.stop(); } catch { /* best-effort */ } }
+        try { await mockIpfs.close(); } catch { /* best-effort */ }
+        try { await fixture.teardown(); } catch { /* best-effort */ }
+      }
+    },
+    600_000,
+  );
+});
-- 
