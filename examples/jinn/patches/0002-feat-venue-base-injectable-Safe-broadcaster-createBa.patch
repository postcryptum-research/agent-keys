 import type { SafeBroadcastPort } from "@jinn-network/marketplace-binding";
 import { buildScriptedChain } from "./broadcast/scripted-chain.fixture.js";
 import { createBaseVenue, type BaseVenue } from "./create-base-venue.js";
-import type { BaseVenueConfig } from "./config.js";
+import type { BaseVenueConfig, SafeBroadcasterDeps, SafeBroadcasterFactory } from "./config.js";
+import type { SafeBroadcastRequest } from "./broadcast/safe-broadcaster.js";
 
 const SAFE = "0x5afe000000000000000000000000000000000000" as Address;
 
@@ -250,4 +251,43 @@ describe("createBaseVenue (Task 17 -- the composition surface program §5 pins)"
     const replacement = createBaseVenue(baseConfig(BASE_SEPOLIA_TODAY, chainB, { stateDbPath: dbPath }));
     replacement.close();
   });
+
+  test("an injected safeBroadcaster factory replaces the EOA broadcaster and shares the venue's lock and ledger", async () => {
+    const chainInstance = buildScriptedChain();
+    const seen: SafeBroadcasterDeps[] = [];
+    const executed: SafeBroadcastRequest[] = [];
+    const injected: SafeBroadcasterFactory = (deps) => {
+      seen.push(deps);
+      return {
+        classify: () => "permanent",
+        async execute(request) {
+          executed.push(request);
+          return { txHash: "0x01" as Hex, blockNumber: 1n, blockHash: "0x02" as Hex, logs: [], alreadySettled: false };
+        },
+        async broadcastCreateTask() {
+          throw new Error("not exercised");
+        },
+      };
+    };
+    // No walletClient at all: the factory is the only signer the venue gets.
+    const { walletClient: _unused, ...withoutWallet } = baseConfig(BASE_SEPOLIA_TODAY, chainInstance);
+    const venue = createBaseVenue({ ...withoutWallet, safeBroadcaster: injected });
+    try {
+      expect(seen).toHaveLength(1);
+      expect(seen[0]!.safeAddress).toBe(SAFE);
+      expect(seen[0]!.chainId).toBe(BASE_SEPOLIA_TODAY.chainId);
+      expect(seen[0]!.lock).toBe(venue.broadcastLock);
+      expect(typeof seen[0]!.ledger.record).toBe("function");
+      await venue.claim.claimTask({ taskId: 1n, priorityMech: venue.claim.priorityMech }).catch(() => {});
+      expect(executed.length).toBeGreaterThan(0);
+    } finally {
+      venue.close();
+    }
+  });
+
+  test("without a walletClient account and without a factory it refuses, naming signer injection", () => {
+    const chainInstance = buildScriptedChain();
+    const { walletClient: _unused, ...withoutWallet } = baseConfig(BASE_SEPOLIA_TODAY, chainInstance);
+    expect(() => createBaseVenue(withoutWallet)).toThrow(/signer-injection/);
+  });
 });
