+/**
+ * What a host-supplied Safe broadcaster is built from: the venue's own durable lock and
+ * submission ledger, so the single-broadcaster rule (design §6.1) holds for it exactly as for
+ * the built-in EOA broadcaster.
+ */
+export interface SafeBroadcasterDeps {
+  readonly chainId: number;
+  readonly safeAddress: Address;
+  readonly publicClient: PublicClient;
+  readonly ledger: SubmissionLedger;
+  readonly lock: BroadcastLock;
+}
+
+/**
+ * Builds the venue's Safe broadcaster when the Safe's owner is not an EOA the host holds a
+ * `WalletClient` for — e.g. a smart account (ERC-4337) whose key lives in hardware and which
+ * calls `execTransaction` itself with a pre-validated (`v = 1`) signature.
+ */
+export type SafeBroadcasterFactory = (deps: SafeBroadcasterDeps) => BaseVenueSafeBroadcaster;
+
 export interface BaseVenueConfig {
   readonly chain: MarketplaceChainConfig;
   readonly publicClient: PublicClient;
-  readonly walletClient: WalletClient;
+  /**
+   * The Safe owner's signer for the built-in broadcaster. Required unless `safeBroadcaster` is
+   * given; ignored when it is.
+   */
+  readonly walletClient?: WalletClient;
+  /** Replaces the built-in EOA Safe broadcaster (signer injection at the broadcaster level). */
+  readonly safeBroadcaster?: SafeBroadcasterFactory;
   readonly safeAddress: Address;
   readonly stateDbPath: string;
   readonly priorityMech: Address;
