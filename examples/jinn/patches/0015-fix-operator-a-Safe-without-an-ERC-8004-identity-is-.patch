+/**
+ * Step 3's proof that the Kernel's agent key signs: `userOpHash` names a UserOperation that the
+ * EntryPoint (v0.7) included with `success`, whose sender is the Kernel, whose nonce key names
+ * the agent permission `permissionId`, and whose block is at most an hour old
+ * (`AGENT_PROOF_MAX_AGE_SECONDS`). An hour leaves time to send it, read the dry run and run the
+ * migration, and not to bring an operation from before a change of the key, the backend or the
+ * mandate. Refuses, with how to make one, otherwise.
+ */
+export async function checkAgentProof(input: {
+  readonly publicClient: Pick<PublicClient, 'getBlock' | 'getLogs'>;
+  readonly kernel: Address;
+  readonly permissionId: Hex;
+  readonly userOpHash: Hex | undefined;
+  readonly agentSignerOpSend?: string;
+}): Promise<{ readonly userOpHash: Hex; readonly blockNumber: bigint; readonly ageSeconds: bigint }> {
+  const kernel = getAddress(input.kernel);
+  const refuse = (why: string) => new Error(
+    `the Safe has no ERC-8004 identity, so this migration sends no operation of the agent's before the handover, and the `
+    + `Kernel ${kernel} has to have proved that its agent key signs under permission ${input.permissionId}: ${why}. `
+    + 'Nothing was changed. Make the proof with an operation the agent\'s mandate allows, signed by the agent key (no --root):\n'
+    + `  ${input.agentSignerOpSend ?? 'agent-signer op send --agent <agent config>'} --target <an allowed target> --data <its calldata>\n`
+    + `then pass its userOpHash within ${AGENT_PROOF_MAX_AGE_SECONDS} s: jinn signer-migrate --agent-proof <userOpHash>`,
+  );
+  const hash = input.userOpHash;
+  if (hash === undefined) throw refuse('no proof was given (--agent-proof)');
+  const latest = await input.publicClient.getBlock();
+  const logs = await input.publicClient.getLogs({
+    address: ENTRY_POINT_V07, event: USER_OPERATION_EVENT, args: { userOpHash: hash },
+    fromBlock: latest.number > AGENT_PROOF_LOOKBACK_BLOCKS ? latest.number - AGENT_PROOF_LOOKBACK_BLOCKS : 0n,
+    toBlock: latest.number,
+  });
+  const log = logs.at(-1);
+  if (log === undefined || log.blockNumber === null) {
+    throw refuse(`the EntryPoint ${ENTRY_POINT_V07} has no UserOperationEvent ${hash} in the last ${AGENT_PROOF_LOOKBACK_BLOCKS} blocks`);
+  }
+  const { sender, nonce, success } = log.args;
+  if (sender === undefined || getAddress(sender) !== kernel) throw refuse(`operation ${hash} was sent by ${sender}, not by the Kernel`);
+  if (success !== true) throw refuse(`operation ${hash} was included and reverted`);
+  if (nonce === undefined || nonce >> 208n !== ((VALIDATION_TYPE_PERMISSION << 32n) | BigInt(input.permissionId))) {
+    throw refuse(
+      `operation ${hash} was not signed with the agent permission: its nonce key is ${toHex((nonce ?? 0n) >> 64n, { size: 24 })}, `
+      + `and the agent's starts 0x0002${input.permissionId.slice(2)}. The owner's operations (key 0, the root path) prove nothing of the agent key`,
+    );
+  }
+  const block = await input.publicClient.getBlock({ blockNumber: log.blockNumber });
+  const ageSeconds = latest.timestamp - block.timestamp;
+  if (ageSeconds > AGENT_PROOF_MAX_AGE_SECONDS) {
+    throw refuse(`operation ${hash} is ${ageSeconds} s old, more than ${AGENT_PROOF_MAX_AGE_SECONDS} s`);
+  }
+  return { userOpHash: hash, blockNumber: log.blockNumber, ageSeconds };
 }
 
