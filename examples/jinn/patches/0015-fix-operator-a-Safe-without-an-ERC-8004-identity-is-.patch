+/** How old step 3's proof may be, in seconds of chain time. */
+export const AGENT_PROOF_MAX_AGE_SECONDS = 3600n;
+// Where the proof's event is looked for: the last 3600 blocks, two hours of Base's two-second
+// blocks (the operator's chains) and an hour even at one-second blocks. The age itself is read
+// from the block's timestamp.
+const AGENT_PROOF_LOOKBACK_BLOCKS = 3600n;
+// Kernel v3.3 nonce key (the nonce's upper 192 bits): mode(1) | validation type(1) | id(20) |
+// key(2). The agent's operations use mode 0 (default) and type 0x02 (permission), with the
+// permission id in the id's first four bytes: the nonce's upper 48 bits are 0x0002 ‖ permission id
+// (agent-signer `permission_nonce_key`). The owner's root path is key 0.
+const VALIDATION_TYPE_PERMISSION = 0x02n;
