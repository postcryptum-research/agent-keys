+import { describe, expect, test } from "vitest";
+import {
+  encodeAbiParameters,
+  encodeEventTopics,
+  encodeFunctionData,
+  encodePacked,
+  getAddress,
+  parseAbi,
+  parseAbiParameters,
+  type Address,
+  type Hex,
+  type Log,
+} from "viem";
+import { SAFE_ABI } from "./safe.js";
+import { erc7579Calls, safeExecutionsOf } from "./safe-executions.js";
+
+const ENTRY_POINT = "0x0000000071727De22E5E9d8BAf0edAc6f37da032" as Address;
+const SAFE = getAddress("0x5afe000000000000000000000000000000000000");
+const OTHER_SAFE = getAddress("0x5afe000000000000000000000000000000000001");
+const ROUTER = "0x1111111111111111111111111111111111111111" as Address;
+const ASSERT = "0x2222222222222222222222222222222222222222" as Address;
+const KERNEL = "0x3333333333333333333333333333333333333333" as Address;
+const OTHER_ACCOUNT = "0x4444444444444444444444444444444444444444" as Address;
+const TX = `0x${"ab".repeat(32)}` as Hex;
+const ZERO = "0x0000000000000000000000000000000000000000" as Address;
+
+const EP_ABI = parseAbi([
+  "function handleOps((address sender, uint256 nonce, bytes initCode, bytes callData, bytes32 accountGasLimits, uint256 preVerificationGas, bytes32 gasFees, bytes paymasterAndData, bytes signature)[] ops, address beneficiary)",
+  "event UserOperationEvent(bytes32 indexed userOpHash, address indexed sender, address indexed paymaster, uint256 nonce, bool success, uint256 actualGasCost, uint256 actualGasUsed)",
+]);
+const EXECUTE_ABI = parseAbi(["function execute(bytes32 mode, bytes executionCalldata)"]);
+
+const routerCall = "0xc47dda39aabbccdd" as Hex;
+function execTransaction(to: Address, data: Hex): Hex {
+  return encodeFunctionData({
+    abi: SAFE_ABI, functionName: "execTransaction",
+    args: [to, 0n, data, 0, 0n, 0n, 0n, ZERO, ZERO, "0x01"],
+  });
+}
+function executeSingle(target: Address, data: Hex): Hex {
+  return encodeFunctionData({
+    abi: EXECUTE_ABI, functionName: "execute",
+    args: [`0x${"00".repeat(32)}`, encodePacked(["address", "uint256", "bytes"], [target, 0n, data])],
+  });
+}
+function executeBatch(calls: readonly { target: Address; data: Hex }[]): Hex {
+  return encodeFunctionData({
+    abi: EXECUTE_ABI, functionName: "execute",
+    args: [
+      `0x01${"00".repeat(31)}`,
+      encodeAbiParameters(parseAbiParameters("(address target, uint256 value, bytes callData)[]"), [
+        calls.map((c) => ({ target: c.target, value: 0n, callData: c.data })),
+      ]),
+    ],
+  });
+}
+function op(sender: Address, nonce: bigint, callData: Hex) {
+  return {
+    sender, nonce, initCode: "0x" as Hex, callData,
+    accountGasLimits: `0x${"00".repeat(32)}` as Hex, preVerificationGas: 0n,
+    gasFees: `0x${"00".repeat(32)}` as Hex, paymasterAndData: "0x" as Hex, signature: "0x" as Hex,
+  };
+}
+function userOpEvent(sender: Address, nonce: bigint, success: boolean): Log {
+  return {
+    address: ENTRY_POINT,
+    topics: encodeEventTopics({
+      abi: EP_ABI, eventName: "UserOperationEvent",
+      args: { userOpHash: `0x${"11".repeat(32)}`, sender, paymaster: ZERO },
+    }),
+    data: encodeAbiParameters(parseAbiParameters("uint256, bool, uint256, uint256"), [nonce, success, 1n, 1n]),
+  } as unknown as Log;
+}
+function client(transaction: { to: Address | null; input: Hex }, logs: readonly Log[] = []) {
+  return {
+    getTransaction: async () => transaction,
+    getTransactionReceipt: async () => ({ logs }),
+  } as unknown as Parameters<typeof safeExecutionsOf>[0];
+}
+
+describe("safeExecutionsOf", () => {
+  test("an owner EOA's execTransaction is the transaction itself", async () => {
+    const executions = await safeExecutionsOf(client({ to: SAFE, input: execTransaction(ROUTER, routerCall) }), TX);
+    expect(executions).toEqual([{ safe: SAFE, to: ROUTER, value: 0n, data: routerCall, operation: 0, via: "direct" }]);
+  });
+
+  test("inside handleOps: the Safe calls of successful UserOperations only, from single and batch execute", async () => {
+    const input = encodeFunctionData({
+      abi: EP_ABI, functionName: "handleOps",
+      args: [[
+        // the Kernel owner: SafeNonceAssert check, then the Safe transaction (TPM_sign's shape)
+        op(KERNEL, 7n, executeBatch([{ target: ASSERT, data: "0x12345678" }, { target: SAFE, data: execTransaction(ROUTER, routerCall) }])),
+        // someone else's operation in the same bundle whose execution reverted
+        op(OTHER_ACCOUNT, 1n, executeSingle(OTHER_SAFE, execTransaction(ROUTER, routerCall))),
+      ], ZERO],
+    });
+    const executions = await safeExecutionsOf(
+      client({ to: ENTRY_POINT, input }, [userOpEvent(KERNEL, 7n, true), userOpEvent(OTHER_ACCOUNT, 1n, false)]),
+      TX,
+    );
+    expect(executions).toEqual([
+      { safe: SAFE, to: ROUTER, value: 0n, data: routerCall, operation: 0, via: "user-operation", account: KERNEL },
+    ]);
+  });
+
+  test("a UserOperationEvent from another contract than the EntryPoint called is ignored", async () => {
+    const input = encodeFunctionData({
+      abi: EP_ABI, functionName: "handleOps",
+      args: [[op(KERNEL, 7n, executeSingle(SAFE, execTransaction(ROUTER, routerCall)))], ZERO],
+    });
+    const forged = { ...userOpEvent(KERNEL, 7n, true), address: ROUTER } as Log;
+    expect(await safeExecutionsOf(client({ to: ENTRY_POINT, input }, [forged]), TX)).toEqual([]);
+  });
+
+  test("anything else yields nothing", async () => {
+    expect(await safeExecutionsOf(client({ to: ROUTER, input: routerCall }), TX)).toEqual([]);
+    const input = encodeFunctionData({
+      abi: EP_ABI, functionName: "handleOps",
+      args: [[op(KERNEL, 0n, executeSingle(ROUTER, routerCall))], ZERO],
+    });
+    expect(await safeExecutionsOf(client({ to: ENTRY_POINT, input }, [userOpEvent(KERNEL, 0n, true)]), TX)).toEqual([]);
+  });
+});
+
+describe("erc7579Calls", () => {
+  test("decodes single and batch CALL modes and refuses the rest", () => {
+    expect(erc7579Calls(executeSingle(SAFE, "0xabcd"))).toEqual([{ target: SAFE, value: 0n, data: "0xabcd" }]);
+    expect(erc7579Calls(executeBatch([{ target: ASSERT, data: "0x01" }, { target: SAFE, data: "0x02" }])).map((c) => c.target))
+      .toEqual([ASSERT, SAFE]);
+    const delegate = encodeFunctionData({
+      abi: EXECUTE_ABI, functionName: "execute",
+      args: [`0xff${"00".repeat(31)}`, encodePacked(["address", "bytes"], [SAFE, "0xabcd"])],
+    });
+    expect(erc7579Calls(delegate)).toEqual([]);
+    expect(erc7579Calls("0xdeadbeef")).toEqual([]);
+  });
+});
diff --git a/packages/marketplace/binding/src/venue/safe-executions.ts b/packages/marketplace/binding/src/venue/safe-executions.ts
new file mode 100644
index 000000000..1d9a97ac5
--- /dev/null
+++ b/packages/marketplace/binding/src/venue/safe-executions.ts
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: MIT
+
+// The Safe transactions a chain transaction actually executed, for readers that bind an event to
+// the calldata behind it (verdict recovery, settlement binding). Two shapes are recognised:
+//
+//   - direct: an owner EOA calls `Safe.execTransaction(...)` -- the transaction's own input;
+//   - ERC-4337: a bundler calls `EntryPoint.handleOps(ops, beneficiary)` (EntryPoint v0.7) and
+//     each UserOperation's account -- an ERC-7579 smart account such as a Kernel that owns the
+//     Safe -- runs `execute(mode, executionCalldata)` with one or more calls, one of which is
+//     `Safe.execTransaction(...)`.
+//
+// For the ERC-4337 shape only UserOperations whose `UserOperationEvent.success` is true count:
+// a bundle can carry an operation whose execution reverted, and its calldata proves nothing.
+import { decodeAbiParameters, decodeEventLog, decodeFunctionData, getAddress, parseAbi, parseAbiParameters, type Address, type Hex, type PublicClient } from "viem";
+import { SAFE_ABI } from "./safe.js";
+
+export interface SafeExecution {
+  /** The Safe that ran the transaction (null only for a transaction without a recipient). */
+  readonly safe: Address | null;
+  readonly to: Address;
+  readonly value: bigint;
+  readonly data: Hex;
+  /** Safe `Enum.Operation`: 0 = CALL, 1 = DELEGATECALL. */
+  readonly operation: number;
+  /** How it reached the Safe: from an owner EOA, or from a smart account's UserOperation. */
+  readonly via: "direct" | "user-operation";
+  /** The smart account (`UserOperation.sender`) for `via: "user-operation"`. */
+  readonly account?: Address;
+}
+
+const ENTRY_POINT_V07_ABI = parseAbi([
+  "function handleOps((address sender, uint256 nonce, bytes initCode, bytes callData, bytes32 accountGasLimits, uint256 preVerificationGas, bytes32 gasFees, bytes paymasterAndData, bytes signature)[] ops, address beneficiary)",
+  "event UserOperationEvent(bytes32 indexed userOpHash, address indexed sender, address indexed paymaster, uint256 nonce, bool success, uint256 actualGasCost, uint256 actualGasUsed)",
+]);
+const ERC7579_EXECUTE_ABI = parseAbi(["function execute(bytes32 mode, bytes executionCalldata)"]);
+const EXECUTIONS = parseAbiParameters("(address target, uint256 value, bytes callData)[]");
+
+const CALLTYPE_SINGLE = 0x00;
+const CALLTYPE_BATCH = 0x01;
+
+function asSafeExecution(
+  safe: Address | null,
+  data: Hex,
+  via: SafeExecution["via"],
+  account?: Address,
+): SafeExecution | undefined {
+  try {
+    const decoded = decodeFunctionData({ abi: SAFE_ABI, data });
+    if (decoded.functionName !== "execTransaction") return undefined;
+    const [to, value, inner, operation] = decoded.args as readonly [Address, bigint, Hex, number, ...unknown[]];
+    return {
+      safe: safe === null ? null : getAddress(safe), to: getAddress(to), value, data: inner, operation: Number(operation), via,
+      ...(account === undefined ? {} : { account: getAddress(account) }),
+    };
+  } catch {
+    return undefined;
+  }
+}
+
+/** The (target, callData) calls of an ERC-7579 `execute` (single or batch CALL; nothing else). */
+export function erc7579Calls(callData: Hex): readonly { readonly target: Address; readonly value: bigint; readonly data: Hex }[] {
+  let decoded;
+  try {
+    decoded = decodeFunctionData({ abi: ERC7579_EXECUTE_ABI, data: callData });
+  } catch {
+    return [];
+  }
+  const [mode, execution] = decoded.args as readonly [Hex, Hex];
+  const callType = Number.parseInt(mode.slice(2, 4), 16);
+  if (callType === CALLTYPE_SINGLE) {
+    // abi.encodePacked(target, value, callData)
+    if (execution.length < 2 + 2 * 52) return [];
+    return [{
+      target: getAddress(`0x${execution.slice(2, 42)}`),
+      value: BigInt(`0x${execution.slice(42, 106)}`),
+      data: `0x${execution.slice(106)}` as Hex,
+    }];
+  }
+  if (callType === CALLTYPE_BATCH) {
+    try {
+      const [calls] = decodeAbiParameters(EXECUTIONS, execution);
+      return calls.map((c) => ({ target: c.target, value: c.value, data: c.callData }));
+    } catch {
+      return [];
+    }
+  }
+  return []; // DELEGATECALL / static / unknown call types are not Safe executions we vouch for
+}
+
+export async function safeExecutionsOf(
+  publicClient: Pick<PublicClient, "getTransaction" | "getTransactionReceipt">,
+  hash: Hex,
+): Promise<readonly SafeExecution[]> {
+  const transaction = await publicClient.getTransaction({ hash });
+  const input = transaction.input;
+
+  let ops;
+  try {
+    const decoded = decodeFunctionData({ abi: ENTRY_POINT_V07_ABI, data: input });
+    if (decoded.functionName !== "handleOps") throw new Error("not handleOps");
+    ops = decoded.args[0];
+  } catch {
+    // Not a bundle: the transaction itself is the Safe execution (or nothing we recognise).
+    const direct = asSafeExecution(transaction.to ?? null, input, "direct");
+    return direct === undefined ? [] : [direct];
+  }
+
+  // Which (sender, nonce) operations of this bundle executed successfully.
+  const receipt = await publicClient.getTransactionReceipt({ hash });
+  const succeeded = new Set<string>();
+  for (const log of receipt.logs) {
+    if (transaction.to === null || transaction.to === undefined
+      || log.address.toLowerCase() !== transaction.to.toLowerCase()) continue;
+    try {
+      const event = decodeEventLog({ abi: ENTRY_POINT_V07_ABI, data: log.data, topics: log.topics as [Hex, ...Hex[]] });
+      if (event.eventName === "UserOperationEvent" && event.args.success) {
+        succeeded.add(`${event.args.sender.toLowerCase()}:${event.args.nonce}`);
+      }
+    } catch {
+      // other EntryPoint events (BeforeExecution, AccountDeployed, Deposited, ...)
+    }
+  }
+
+  const executions: SafeExecution[] = [];
+  for (const op of ops) {
+    if (!succeeded.has(`${op.sender.toLowerCase()}:${op.nonce}`)) continue;
+    for (const call of erc7579Calls(op.callData)) {
+      const execution = asSafeExecution(call.target, call.data, "user-operation", op.sender);
+      if (execution !== undefined) executions.push(execution);
+    }
+  }
+  return executions;
+}
