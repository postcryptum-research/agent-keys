@@ -0,0 +1,85 @@
+// The CLI verbs' Safe broadcaster for a Kernel-owned Safe: refuses at once when the Kernel does
+// not own the Safe, and keeps its ledger in the daemon's venue state (`<earningDir>/../venue`),
+// so a verb and a daemon share the lock and the reconciliation record.
+import { chmodSync, existsSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+import { encodeAbiParameters, encodeEventTopics, parseAbiItem, type Address, type Hex } from 'viem';
+import { createSubmissionLedger, openVenueState } from '@jinn-network/marketplace-venue-base';
+
+import { openCliKernelSafeBroadcaster } from '../../src/signer/index.js';
+import { ENTRY_POINT_V07 } from '../../src/signer/kernel-safe-broadcaster.js';
+
+const KERNEL = '0xEdB645B14e2f952C5784e34949b58F0826fBc9E9' as Address;
+const SAFE = '0xd0b972a8ee7D8AB91a2e3381Eb6F10550B80E52A' as Address;
+const REGISTRY = '0x8004A169FB4a3325136EB29fA0ceB6D2e539a432' as Address;
+const OP = `0x${'a1'.repeat(32)}` as Hex;
+const TX = `0x${'c3'.repeat(32)}` as Hex;
+
+let dir: string;
+beforeEach(() => { dir = mkdtempSync(join(tmpdir(), 'cli-kernel-')); });
+afterEach(() => { rmSync(dir, { recursive: true, force: true }); });
+
+function fakeAgentSigner(): string {
+  const bin = join(dir, 'agent-signer');
+  writeFileSync(bin, `#!/usr/bin/env node
+process.stderr.write('userOpHash:     ${OP}\\n');
+process.stdout.write(JSON.stringify({ account: '${KERNEL}', userOpHash: '${OP}', nonce: '0x1', tx: '${TX}', block: 9, gasUsed: 1 }) + '\\n');
+`);
+  chmodSync(bin, 0o755);
+  return bin;
+}
+
+function chain(isOwner: boolean) {
+  const event = parseAbiItem('event UserOperationEvent(bytes32 indexed userOpHash, address indexed sender, address indexed paymaster, uint256 nonce, bool success, uint256 actualGasCost, uint256 actualGasUsed)');
+  return {
+    async readContract(args: { functionName: string }) {
+      if (args.functionName === 'isOwner') return isOwner;
+      if (args.functionName === 'nonce') return 4n;
+      throw new Error(`unexpected read ${args.functionName}`);
+    },
+    async getTransactionReceipt() {
+      return {
+        blockNumber: 9n, blockHash: `0x${'0e'.repeat(32)}`, status: 'success',
+        logs: [{
+          address: ENTRY_POINT_V07,
+          topics: encodeEventTopics({ abi: [event], eventName: 'UserOperationEvent', args: { userOpHash: OP, sender: KERNEL, paymaster: '0x0000000000000000000000000000000000000000' } }),
+          data: encodeAbiParameters([{ type: 'uint256' }, { type: 'bool' }, { type: 'uint256' }, { type: 'uint256' }], [0n, true, 1n, 1n]),
+        }],
+      };
+    },
+  };
+}
+
+const section = (bin: string) => ({ kind: 'agent-signer' as const, bin, config: 'agent.json', account: KERNEL, sponsored: false });
+
+describe('openCliKernelSafeBroadcaster', () => {
+  it('refuses when the Kernel does not own the Safe', async () => {
+    const earningDir = join(dir, 'earning');
+    await expect(openCliKernelSafeBroadcaster({
+      section: section(fakeAgentSigner()), earningDir, chainId: 84532, publicClient: chain(false) as never, safeAddress: SAFE,
+    })).rejects.toThrow(/is not an owner of the service Safe/);
+    expect(existsSync(join(dir, 'venue', 'venue.db'))).toBe(false);
+  });
+
+  it('sends through agent-signer and records the attempt in the daemon venue state', async () => {
+    const earningDir = join(dir, 'earning');
+    mkdirSync(earningDir);
+    const broadcaster = await openCliKernelSafeBroadcaster({
+      section: section(fakeAgentSigner()), earningDir, chainId: 84532, publicClient: chain(true) as never, safeAddress: SAFE,
+    });
+    expect(broadcaster.safeAddress).toBe(SAFE);
+    const receipt = await broadcaster.execute({ to: REGISTRY, value: 0n, data: '0x466648da', logicalTx: 'solver-plugins.publish' });
+    expect(receipt.txHash).toBe(TX);
+
+    const state = openVenueState(join(dir, 'venue', 'venue.db'));
+    try {
+      const row = createSubmissionLedger(state).get({ chainId: 84532, from: KERNEL, nonce: 4 });
+      expect(row).toMatchObject({ txHash: OP, logicalTx: 'solver-plugins.publish' });
