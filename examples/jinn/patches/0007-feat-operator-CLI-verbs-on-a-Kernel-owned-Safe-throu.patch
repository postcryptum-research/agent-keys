+/**
+ * A one-shot CLI verb's Safe broadcaster for a Kernel-owned Safe. Built on the daemon's own
+ * venue state (`<earningDir>/../venue/venue.db`): its broadcast lock is cross-process, so the
+ * verb and a daemon serialize on the Kernel account, and the submission ledger reconciles an
+ * attempt the verb or the daemon left with an unknown outcome.
+ */
+export async function openCliKernelSafeBroadcaster(input: {
+  readonly section: SignerSection;
+  readonly earningDir: string;
+  readonly chainId: number;
+  readonly publicClient: PublicClient;
+  readonly safeAddress: Address;
+}): Promise<{ readonly safeAddress: Address; execute: ReturnType<SafeBroadcasterFactory>['execute'] }> {
+  const { mkdirSync } = await import('node:fs');
+  const { dirname, join } = await import('node:path');
+  const { createBroadcastLock, createSubmissionLedger, openVenueState } = await import('@jinn-network/marketplace-venue-base');
+  const factory = await agentSignerSafeBroadcaster(input.section, input.publicClient, input.safeAddress);
+  const statePath = join(input.earningDir, '..', 'venue', 'venue.db');
+  mkdirSync(dirname(statePath), { recursive: true });
+  const state = openVenueState(statePath);
+  const broadcaster = factory({
+    chainId: input.chainId,
+    safeAddress: input.safeAddress,
+    // venue-base resolves its own copy of viem (finding E26 in composition-root.ts).
+    publicClient: input.publicClient as never,
+    ledger: createSubmissionLedger(state),
+    lock: createBroadcastLock(state),
+  });
+  return { safeAddress: input.safeAddress, execute: (request) => broadcaster.execute(request) };
+}
