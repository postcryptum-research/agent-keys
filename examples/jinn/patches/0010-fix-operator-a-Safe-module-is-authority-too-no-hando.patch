+/**
+ * Hermetic gate -- what `jinn signer-migrate` (src/signer/migrate.ts) and the "no authority"
+ * check (src/signer/attestation.ts) refuse, on a real Safe.
+ *
+ * A Safe module is not an owner: `execTransactionFromModule` runs any call from the Safe for it,
+ * with no owner's signature, and `swapOwner` leaves it enabled. A keystore EOA that is a module of
+ * the Safe would keep the Safe after a handover that reports "the EOA has no authority". Mocks
+ * cannot show that; these cases run against Safe 1.3.0's own bytecode, on a Safe created from the
+ * snapshot's proxy factory:
+ *
+ *   - the migration refuses while the agent EOA is an enabled module, and nothing changes hands;
+ *   - after a swap done by hand the former owner still moves value out of the Safe, and neither
+ *     the check nor a re-run of the migration reports that Safe as handed over;
+ *   - every other module is listed for review, across pages (Safe 1.3.0 returns the following
+ *     page's first module as `next`).
+ *
+ * Every case stops before the Kernel is asked for anything, so there is no Kernel here and no
+ * agent-signer: the complete handover is `full-loop-kernel-owner.test.ts`.
+ *
+ * Deterministic on the snapshot (spawnAnvilFromState, no live RPC). SKIP-CLEAN when the fixture
+ * is absent.
+ */
+
+import { existsSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';
+import {
+  createPublicClient,
+  createWalletClient,
+  decodeEventLog,
+  encodeFunctionData,
+  http,
+  parseAbi,
+  parseEther,
+  zeroAddress,
+  type Address,
+  type Hex,
+  type PublicClient,
+  type WalletClient,
+} from 'viem';
+import { base } from 'viem/chains';
+import { generatePrivateKey, privateKeyToAccount } from 'viem/accounts';
+
+import { spawnAnvilFromState, type AnvilHarness } from '../_support/chain/anvil.js';
+import { assertAgentEoaHasNoAuthority, readSafeModuleAuthority } from '../../src/signer/attestation.js';
+import { migrateToKernelOwner } from '../../src/signer/migrate.js';
+
+const TEST_DIR = dirname(fileURLToPath(import.meta.url));
+const SNAPSHOT_STATE = resolve(TEST_DIR, '..', '_support', 'fixtures', 'anvil-base-v3-state', 'state.json');
+const describeMaybe = existsSync(SNAPSHOT_STATE) ? describe : describe.skip;
+
+// Safe 1.3.0 on the snapshot (the canonical deployment addresses).
+const SAFE_SINGLETON = '0xd9Db270c1B5E3Bd161E8c8503c55cEABeE709552' as Address;
+const SAFE_PROXY_FACTORY = '0xa6B71E26C5e0845f74c812102Ca7114b6a896AB2' as Address;
+const SENTINEL = '0x0000000000000000000000000000000000000001' as Address;
+
+const FACTORY_ABI = parseAbi([
+  'function createProxyWithNonce(address singleton, bytes initializer, uint256 saltNonce) returns (address proxy)',
+  'event ProxyCreation(address proxy, address singleton)',
+]);
+const SAFE_ABI = parseAbi([
+  'function setup(address[] owners, uint256 threshold, address to, bytes data, address fallbackHandler, address paymentToken, uint256 payment, address paymentReceiver)',
+  'function getOwners() view returns (address[])',
+  'function isOwner(address owner) view returns (bool)',
+  'function isModuleEnabled(address module) view returns (bool)',
+  'function enableModule(address module)',
+  'function swapOwner(address prevOwner, address oldOwner, address newOwner)',
+  'function execTransaction(address to, uint256 value, bytes data, uint8 operation, uint256 safeTxGas, uint256 baseGas, uint256 gasPrice, address gasToken, address refundReceiver, bytes signatures) payable returns (bool)',
+  'function execTransactionFromModule(address to, uint256 value, bytes data, uint8 operation) returns (bool)',
+]);
+
+const fresh = (): Address => privateKeyToAccount(generatePrivateKey()).address;
+
