+    publicClient = createPublicClient({ chain: base, transport: http(anvil.rpcUrl) }) as unknown as PublicClient;
+    eoaWallet = createWalletClient({ account: eoaAccount, chain: base, transport: http(anvil.rpcUrl) });
+    await anvil.setBalance(eoa, parseEther('10'));
+  });
+  afterAll(async () => { await anvil?.teardown(); });
+
+  async function mined(hash: Hex) {
+    const receipt = await publicClient.waitForTransactionReceipt({ hash });
+    expect(receipt.status).toBe('success');
