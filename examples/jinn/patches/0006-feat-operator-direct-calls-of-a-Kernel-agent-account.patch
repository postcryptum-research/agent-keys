   return null;
 }
 
+/**
+ * Wallets whose `sendTransaction` is not an EOA transaction but a UserOperation of a smart
+ * account, sent and waited for by an external signer (e.g. `src/signer/` over TPM_sign's
+ * agent-signer). For them an EOA nonce, a fee bump or a stuck-nonce eviction means nothing, and
+ * a blind resend after an unknown outcome could execute the call twice.
+ */
+const userOperationWallets = new WeakSet<object>();
+
+/** Mark `walletClient` as sending UserOperations (see `viemSendTransactionWithRetry`). */
+export function markUserOperationWallet<T extends object>(walletClient: T): T {
+  userOperationWallets.add(walletClient);
+  return walletClient;
+}
+
+export function isUserOperationWallet(walletClient: unknown): boolean {
+  return typeof walletClient === 'object' && walletClient !== null && userOperationWallets.has(walletClient);
+}
+
 export async function viemSendTransactionWithRetry(
   walletClient: TxRetryWalletClient,
   publicClient: PublicClient,
   txRequest: TxRetryTransactionRequest,
   options: TxRetryOptions = {},
 ): Promise<Hex> {
+  if (isUserOperationWallet(walletClient)) {
+    // One attempt, serialized with every other broadcast of the same account (the venue's Safe
+    // transactions included, through the installed default lock): the signer owns nonce, fees
+    // and inclusion, and only it can tell whether an unknown outcome landed.
+    const account = txRequest.account ?? walletClient.account;
+    const from = typeof account === 'string' ? (account as Address) : accountAddress(account);
+    if (from === undefined) throw new Error('user-operation wallet: the transaction has no account address');
+    const { nonce: _nonce, gas: _gas, gasPrice: _gasPrice, maxFeePerGas: _max, maxPriorityFeePerGas: _prio, ...req } =
+      txRequest as TxRetryTransactionRequest & { gasPrice?: unknown; maxFeePerGas?: unknown; maxPriorityFeePerGas?: unknown };
+    return withEoaBroadcastLock(from, async () => {
+      const hash = await walletClient.sendTransaction(req as TxRetryTransactionRequest);
+      options.onBroadcast?.(hash);
+      return hash;
+    });
+  }
   const maxAttempts = options.maxAttempts ?? TX_RETRY_DEFAULTS.maxAttempts;
   const baseDelayMs = options.baseDelayMs ?? TX_RETRY_DEFAULTS.baseDelayMs;
   const maxDelayMs = options.maxDelayMs ?? TX_RETRY_DEFAULTS.maxDelayMs;
