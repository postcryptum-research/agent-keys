+
+/**
+ * A WalletClient for the agent's Kernel account: `account` is the Kernel's address (a json-rpc
+ * account), transactions go through agent-signer, and the client is marked so `tx-retry` sends
+ * each one exactly once under the account's broadcast lock (no EOA nonce, fee bump or eviction).
+ */
+export function createAgentSignerWalletClient(input: {
+  readonly rpcUrl: string;
+  readonly chain: Chain;
+  readonly signer: AgentSignerConfig;
+  readonly send?: (cfg: AgentSignerConfig, call: AgentSignerCall) => Promise<AgentSignerResult>;
+}): WalletClient {
+  return markUserOperationWallet(createWalletClient({
+    account: input.signer.account,
+    chain: input.chain,
+    transport: agentSignerTransport(input.rpcUrl, input.signer, input.send),
+  }));
+}
