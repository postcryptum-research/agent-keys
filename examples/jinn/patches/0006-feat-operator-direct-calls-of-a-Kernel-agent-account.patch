diff --git a/operator/test/signer/user-operation-wallet.test.ts b/operator/test/signer/user-operation-wallet.test.ts
new file mode 100644
index 000000000..cee544148
--- /dev/null
+++ b/operator/test/signer/user-operation-wallet.test.ts
@@ -0,0 +1,101 @@
+// Direct (non-Safe) calls from a Kernel account: `tx-retry` must send them once, under the
+// account's broadcast lock, without the EOA machinery (nonce ledger, fee bumps, stuck-nonce
+// eviction, blind resends) -- agent-signer owns nonce, fees and inclusion.
+import { createServer } from 'node:http';
+import type { AddressInfo } from 'node:net';
+import { describe, expect, it, vi } from 'vitest';
+import type { Address, Hex, PublicClient } from 'viem';
+import { baseSepolia } from 'viem/chains';
+
+import { isUserOperationWallet, markUserOperationWallet, viemSendTransactionWithRetry } from '../../src/tx-retry.js';
+import { createAgentSignerWalletClient } from '../../src/signer/agent-signer-transport.js';
+import type { AgentSignerCall, AgentSignerResult } from '../../src/signer/agent-signer-cli.js';
+
+const KERNEL = '0xEdB645B14e2f952C5784e34949b58F0826fBc9E9' as Address;
+const REGISTRY = '0x8004A169FB4a3325136EB29fA0ceB6D2e539a432' as Address;
+const TX = `0x${'c3'.repeat(32)}` as Hex;
+
+/** Any RPC use would be the EOA machinery at work: fail loudly. */
+const untouchable = new Proxy({}, {
+  get: (_target, property) => () => { throw new Error(`publicClient.${String(property)} must not be called`); },
+}) as unknown as PublicClient;
+
+describe('viemSendTransactionWithRetry with a user-operation wallet', () => {
+  it('sends once, without nonce or fee fields, and never reads the chain', async () => {
+    const sendTransaction = vi.fn(async () => TX);
+    const wallet = markUserOperationWallet({ account: { address: KERNEL, type: 'json-rpc' }, sendTransaction });
+    const onBroadcast = vi.fn();
+    const hash = await viemSendTransactionWithRetry(wallet, untouchable, {
+      account: wallet.account, to: REGISTRY, data: '0x1234', value: 0n,
+      nonce: 7, gas: 1n, maxFeePerGas: 2n, maxPriorityFeePerGas: 3n,
+    }, { logicalTx: 'erc8004.setMetadata', onBroadcast });
+    expect(hash).toBe(TX);
+    expect(sendTransaction).toHaveBeenCalledTimes(1);
+    expect(sendTransaction).toHaveBeenCalledWith({ account: wallet.account, to: REGISTRY, data: '0x1234', value: 0n });
+    expect(onBroadcast).toHaveBeenCalledWith(TX);
+  });
+
+  it('does not resend after a failure whose outcome it cannot know', async () => {
+    const sendTransaction = vi.fn(async () => { throw new Error('nonce too low'); }); // "recoverable" for an EOA
+    const wallet = markUserOperationWallet({ account: { address: KERNEL }, sendTransaction });
+    await expect(viemSendTransactionWithRetry(wallet, untouchable, { account: wallet.account, to: REGISTRY, data: '0x' }))
+      .rejects.toThrow(/nonce too low/);
+    expect(sendTransaction).toHaveBeenCalledTimes(1);
+  });
+
+  it('serializes concurrent sends of the same account', async () => {
+    let inFlight = 0;
+    let maxInFlight = 0;
+    const sendTransaction = vi.fn(async () => {
+      inFlight += 1;
+      maxInFlight = Math.max(maxInFlight, inFlight);
+      await new Promise((r) => setTimeout(r, 20));
+      inFlight -= 1;
+      return TX;
+    });
+    const wallet = markUserOperationWallet({ account: { address: KERNEL }, sendTransaction });
+    await Promise.all([1, 2, 3].map(() =>
+      viemSendTransactionWithRetry(wallet, untouchable, { account: wallet.account, to: REGISTRY, data: '0x' })));
+    expect(sendTransaction).toHaveBeenCalledTimes(3);
+    expect(maxInFlight).toBe(1);
+  });
+
+  it('an unmarked wallet keeps the EOA path', () => {
+    expect(isUserOperationWallet({ account: { address: KERNEL }, sendTransaction: async () => TX })).toBe(false);
+  });
+});
+
+describe('createAgentSignerWalletClient', () => {
+  it('is a marked wallet of the Kernel account whose transactions go to agent-signer', async () => {
+    const calls: AgentSignerCall[] = [];
+    const send = async (_cfg: unknown, call: AgentSignerCall): Promise<AgentSignerResult> => {
+      calls.push(call);
+      return { account: KERNEL, userOpHash: TX, nonce: '0x1', txHash: TX, blockNumber: 1n, gasUsed: 1n };
+    };
+    // The RPC answers only the chain check viem makes before sending; anything else would fail.
+    const rpc = createServer((req, res) => {
+      let body = '';
+      req.on('data', (c) => { body += c; });
+      req.on('end', () => {
+        const { id, method } = JSON.parse(body) as { id: number; method: string };
+        res.setHeader('content-type', 'application/json');
+        res.end(JSON.stringify(method === 'eth_chainId'
+          ? { jsonrpc: '2.0', id, result: `0x${baseSepolia.id.toString(16)}` }
+          : { jsonrpc: '2.0', id, error: { code: -32601, message: `unexpected ${method}` } }));
+      });
+    });
+    await new Promise<void>((r) => rpc.listen(0, '127.0.0.1', r));
+    const wallet = createAgentSignerWalletClient({
+      rpcUrl: `http://127.0.0.1:${(rpc.address() as AddressInfo).port}`, chain: baseSepolia,
+      signer: { bin: 'agent-signer', configPath: 'agent.json', account: KERNEL }, send,
+    });
+    expect(isUserOperationWallet(wallet)).toBe(true);
+    expect(wallet.account?.address).toBe(KERNEL);
+    const hash = await viemSendTransactionWithRetry(wallet as never, untouchable, {
+      account: wallet.account, to: REGISTRY, data: '0xabcdef', value: 0n,
+    });
+    expect(hash).toBe(TX);
+    expect(calls).toEqual([{ to: REGISTRY, value: 0n, data: '0xabcdef' }]);
+    rpc.close();
+  });
+});
