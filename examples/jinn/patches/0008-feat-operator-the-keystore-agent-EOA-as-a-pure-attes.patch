         const signer: AgentSignerConfig = {
           bin: AGENT_SIGNER!, configPath, account: kernel, envFile: join(work, '.env'), timeoutMs: 240_000,
@@ -287,6 +297,19 @@ describeMaybe('hermetic daemon solution loop, Safe owned by a hardware-signed Ke
         const metadataTx = await fixture.publicClient.getTransaction({ hash: published.txHash as Hex });
         expect(metadataTx.to?.toLowerCase()).toBe(ENTRY_POINT_V07.toLowerCase());
 
+        // ── Off-chain signatures (ADAPTATION item 10): the EOA is the agent's attestation key ──
+        const bound = await ensureAttestationKeyBinding({
+          publicClient: fixture.publicClient, wallet: direct as never, identityRegistry: IDENTITY_REGISTRY, agentId,
+          attestationAddress: operator.agentAddress,
+        });
+        expect(bound.status).toBe('published');
+        expect(await ensureAttestationKeyBinding({
+          publicClient: fixture.publicClient, wallet: direct as never, identityRegistry: IDENTITY_REGISTRY, agentId,
+          attestationAddress: operator.agentAddress,
