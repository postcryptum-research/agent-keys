+        expect(await readAttestationKey({ publicClient: fixture.publicClient, identityRegistry: IDENTITY_REGISTRY, agentId }))
+          .toBe(getAddress(operator.agentAddress));
+
         // ── A CLI verb (ADAPTATION item 7): `jinn solver-plugins publish` with `config.signer` ──
         // The production publisher factory, as the verb builds it: no keystore is opened; the
         // ERC-8004 record is written through the Safe, by the Kernel, via agent-signer, on the
diff --git a/operator/test/signer/attestation.test.ts b/operator/test/signer/attestation.test.ts
new file mode 100644
index 000000000..eab8f97b5
--- /dev/null
+++ b/operator/test/signer/attestation.test.ts
@@ -0,0 +1,81 @@
+// Off-chain signing under a Kernel owner: the keystore agent EOA may only attest (no Safe, no
+// agent NFT), and the Kernel publishes it as the agent's attestation key, once.
+import { describe, expect, it, vi } from 'vitest';
+import { decodeFunctionData, parseAbi, type Address, type Hex } from 'viem';
+
+import {
+  ATTESTATION_KEY_METADATA,
+  assertAgentEoaHasNoAuthority,
+  ensureAttestationKeyBinding,
+  readAttestationKey,
+} from '../../src/signer/attestation.js';
+import { markUserOperationWallet } from '../../src/tx-retry.js';
+
+const EOA = '0x7471bE25Ec54354c8D70491Ae10bd86705fAD030' as Address;
+const KERNEL = '0xEdB645B14e2f952C5784e34949b58F0826fBc9E9' as Address;
+const SAFE = '0xd0b972a8ee7D8AB91a2e3381Eb6F10550B80E52A' as Address;
+const REGISTRY = '0x8004A169FB4a3325136EB29fA0ceB6D2e539a432' as Address;
+const TX = `0x${'c3'.repeat(32)}` as Hex;
+
+function chain(state: { safeOwner: boolean; nftOwner: Address; metadata: Hex }) {
+  return {
+    async readContract(args: { functionName: string; args: readonly unknown[] }) {
+      if (args.functionName === 'isOwner') return state.safeOwner && args.args[0] === EOA;
+      if (args.functionName === 'ownerOf') return state.nftOwner;
+      if (args.functionName === 'getMetadata') {
+        expect(args.args[1]).toBe(ATTESTATION_KEY_METADATA);
+        return state.metadata;
+      }
+      throw new Error(`unexpected ${args.functionName}`);
+    },
+    async waitForTransactionReceipt() { return { status: 'success' }; },
+  };
+}
+
+describe('assertAgentEoaHasNoAuthority', () => {
+  const identity = { identityRegistry: REGISTRY, agentId: 7n };
+
+  it('refuses while the EOA still owns the Safe or the agent NFT', async () => {
+    await expect(assertAgentEoaHasNoAuthority({
+      publicClient: chain({ safeOwner: true, nftOwner: KERNEL, metadata: '0x' }) as never, agentEoa: EOA, safeAddress: SAFE, ...identity,
+    })).rejects.toThrow(/still an owner of the service Safe/);
+    await expect(assertAgentEoaHasNoAuthority({
+      publicClient: chain({ safeOwner: false, nftOwner: EOA, metadata: '0x' }) as never, agentEoa: EOA, safeAddress: SAFE, ...identity,
+    })).rejects.toThrow(/still owns agent NFT 7/);
+  });
+
+  it('passes once the Kernel owns both', async () => {
+    await expect(assertAgentEoaHasNoAuthority({
+      publicClient: chain({ safeOwner: false, nftOwner: KERNEL, metadata: '0x' }) as never, agentEoa: EOA, safeAddress: SAFE, ...identity,
+    })).resolves.toBeUndefined();
+  });
+});
+
+describe('ensureAttestationKeyBinding', () => {
+  it('publishes the attestation address from the Kernel once, then leaves it', async () => {
+    const state = { safeOwner: false, nftOwner: KERNEL, metadata: '0x' as Hex };
+    const sendTransaction = vi.fn(async (tx: { data: Hex; to: Address }) => {
+      const call = decodeFunctionData({ abi: parseAbi(['function setMetadata(uint256, string, bytes)']), data: tx.data });
+      state.metadata = call.args[2] as Hex;
+      return TX;
+    });
+    const wallet = markUserOperationWallet({ account: { address: KERNEL, type: 'json-rpc' }, sendTransaction });
+    const input = { publicClient: chain(state) as never, wallet: wallet as never, identityRegistry: REGISTRY, agentId: 7n, attestationAddress: EOA };
+
+    await expect(ensureAttestationKeyBinding(input)).resolves.toEqual({ status: 'published', txHash: TX });
+    expect(sendTransaction).toHaveBeenCalledTimes(1);
+    expect(sendTransaction.mock.calls[0]![0].to).toBe(REGISTRY);
+    expect(state.metadata).toBe(EOA.toLowerCase());
+
+    await expect(ensureAttestationKeyBinding(input)).resolves.toEqual({ status: 'already-bound' });
+    expect(sendTransaction).toHaveBeenCalledTimes(1);
+    await expect(readAttestationKey({ publicClient: chain(state) as never, identityRegistry: REGISTRY, agentId: 7n }))
+      .resolves.toBe(EOA);
+  });
+
+  it('reads nothing when no key is published', async () => {
+    await expect(readAttestationKey({
+      publicClient: chain({ safeOwner: false, nftOwner: KERNEL, metadata: '0x' }) as never, identityRegistry: REGISTRY, agentId: 7n,
+    })).resolves.toBeNull();
+  });
+});
