diff --git a/operator/src/signer/attestation.ts b/operator/src/signer/attestation.ts
new file mode 100644
index 000000000..eba803c33
--- /dev/null
+++ b/operator/src/signer/attestation.ts
@@ -0,0 +1,115 @@
+// SPDX-License-Identifier: MIT
+
+// Off-chain signatures under a hardware-signed Kernel owner (ADAPTATION §4, option 2).
+//
+// Jinn's off-chain documents -- task.v1, execution envelopes, captures, the legacy bridge -- are
+// raw secp256k1 signatures that verifiers check against the address inside the document. A
+// P-256 key in a TPM / Secure Enclave / TROPIC01 cannot produce them, and no verifier calls
+// ERC-1271. So the agent EOA keeps signing documents -- but once the Kernel owns the service
+// Safe and the agent NFT, that EOA holds no on-chain authority: it becomes a pure attestation
+// key. Its compromise forges attestations (a reputational risk), never moves funds or rights.
+//
+// Two things make that a guarantee rather than an assumption:
+//   - `assertAgentEoaHasNoAuthority` refuses to boot while the EOA still owns the Safe or the
+//     agent NFT (an unfinished migration);
+//   - `ensureAttestationKeyBinding` has the Kernel publish, under the agent's ERC-8004 identity,
+//     which address signs its documents (`jinn.attestationKey`), so a verifier can bind a
+//     document signer to the agent on-chain.
+import { encodeFunctionData, getAddress, parseAbi, type Address, type Hex, type PublicClient, type WalletClient } from 'viem';
+
+import { viemSendTransactionWithRetry, type TxRetryWalletClient } from '../tx-retry.js';
+
+export const ATTESTATION_KEY_METADATA = 'jinn.attestationKey';
+
+const SAFE_ABI = parseAbi(['function isOwner(address owner) view returns (bool)']);
+const IDENTITY_ABI = parseAbi([
+  'function ownerOf(uint256 tokenId) view returns (address)',
+  'function getMetadata(uint256 agentId, string metadataKey) view returns (bytes)',
+  'function setMetadata(uint256 agentId, string metadataKey, bytes metadataValue)',
+]);
+
+type Reader = Pick<PublicClient, 'readContract'>;
+
+/** Refuse while the agent EOA still has on-chain authority over the Safe or the agent NFT. */
+export async function assertAgentEoaHasNoAuthority(input: {
+  readonly publicClient: Reader;
+  readonly agentEoa: Address;
+  readonly safeAddress: Address;
+  readonly identityRegistry?: Address;
+  readonly agentId?: bigint;
+}): Promise<void> {
+  const problems: string[] = [];
+  const safeOwner = await input.publicClient.readContract({
+    address: input.safeAddress, abi: SAFE_ABI, functionName: 'isOwner', args: [input.agentEoa],
+  });
+  if (safeOwner) problems.push(`it is still an owner of the service Safe ${input.safeAddress} (swapOwner it out)`);
+  if (input.identityRegistry !== undefined && input.agentId !== undefined) {
+    const nftOwner = await input.publicClient.readContract({
+      address: input.identityRegistry, abi: IDENTITY_ABI, functionName: 'ownerOf', args: [input.agentId],
+    });
+    if (getAddress(nftOwner) === getAddress(input.agentEoa)) {
+      problems.push(`it still owns agent NFT ${input.agentId} (transfer it to the Kernel account)`);
+    }
+  }
+  if (problems.length > 0) {
+    throw new Error(
+      `signer: the keystore agent EOA ${input.agentEoa} must only sign off-chain documents once the `
+      + `Kernel account owns the agent, but ${problems.join('; ')}`,
+    );
+  }
+}
+
+export type AttestationBinding =
+  | { readonly status: 'already-bound' }
+  | { readonly status: 'published'; readonly txHash: Hex };
+
+/**
+ * Publish `jinn.attestationKey = <attestation address>` (20 raw bytes) under `agentId` from the
+ * Kernel account, unless it already says exactly that.
+ */
+export async function ensureAttestationKeyBinding(input: {
+  readonly publicClient: Reader & Pick<PublicClient, 'waitForTransactionReceipt'>;
+  /** The Kernel account's wallet (`createAgentSignerWalletClient`). */
+  readonly wallet: WalletClient;
+  readonly identityRegistry: Address;
+  readonly agentId: bigint;
+  readonly attestationAddress: Address;
+}): Promise<AttestationBinding> {
+  const expected = getAddress(input.attestationAddress).toLowerCase() as Hex;
+  const current = await input.publicClient.readContract({
+    address: input.identityRegistry, abi: IDENTITY_ABI, functionName: 'getMetadata',
+    args: [input.agentId, ATTESTATION_KEY_METADATA],
+  });
+  if (current.toLowerCase() === expected) return { status: 'already-bound' };
+  const account = input.wallet.account;
+  if (account === undefined) throw new Error('ensureAttestationKeyBinding: the wallet has no account');
+  const txHash = await viemSendTransactionWithRetry(
+    input.wallet as unknown as TxRetryWalletClient,
+    input.publicClient as PublicClient,
+    {
+      account,
+      to: input.identityRegistry,
+      data: encodeFunctionData({
+        abi: IDENTITY_ABI, functionName: 'setMetadata', args: [input.agentId, ATTESTATION_KEY_METADATA, expected],
+      }),
+      value: 0n,
+    },
+    { logicalTx: 'erc8004.attestationKey' },
+  );
+  const receipt = await input.publicClient.waitForTransactionReceipt({ hash: txHash });
+  if (receipt.status !== 'success') throw new Error(`publishing ${ATTESTATION_KEY_METADATA} reverted (tx ${txHash})`);
+  return { status: 'published', txHash };
+}
+
+/** What `jinn.attestationKey` says for `agentId`, if anything. */
+export async function readAttestationKey(input: {
+  readonly publicClient: Reader;
+  readonly identityRegistry: Address;
+  readonly agentId: bigint;
+}): Promise<Address | null> {
+  const value = await input.publicClient.readContract({
+    address: input.identityRegistry, abi: IDENTITY_ABI, functionName: 'getMetadata',
+    args: [input.agentId, ATTESTATION_KEY_METADATA],
+  });
+  return value.length === 42 ? getAddress(value) : null;
+}
