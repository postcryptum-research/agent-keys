+/**
+ * A Safe's guard and fallback handler, read from their storage slots, and what in them this
+ * setup refuses (`problems`, one line each, with the call that clears it):
+ *   - a guard runs before and after every transaction of the Safe and can veto each, and this
+ *     setup sets none: any guard is refused, unless it is also an enabled module of the Safe. A
+ *     module already runs any call from the Safe, `setGuard` included, so such a guard is the
+ *     module the operator reviews. stOLAS sets its MultisigGuard so on the service Safe it
+ *     creates, and that guard keeps itself set: it reverts every transaction after which the
+ *     Safe's guard is another;
+ *   - the fallback handler answers what the Safe does not implement, `isValidSignature` among
+ *     it: it decides the Safe's ERC-1271 answers. Zero or Safe's own CompatibilityFallbackHandler
+ *     of the Safe's version passes; any other handler is refused.
+ */
+export async function readSafeGuardAndHandler(input: {
+  readonly publicClient: Reader & Pick<PublicClient, 'getStorageAt'>;
+  readonly safeAddress: Address;
+}): Promise<{ readonly guard: Address; readonly fallbackHandler: Address; readonly problems: readonly string[] }> {
+  const addressAt = async (slot: Hex): Promise<Address> => {
+    const word = await input.publicClient.getStorageAt({ address: input.safeAddress, slot });
+    return getAddress(`0x${(word ?? '0x').slice(2).padStart(64, '0').slice(-40)}`);
+  };
+  const guard = await addressAt(GUARD_STORAGE_SLOT);
+  const fallbackHandler = await addressAt(FALLBACK_HANDLER_STORAGE_SLOT);
+  const problems: string[] = [];
+  if (guard !== zeroAddress && !(await input.publicClient.readContract({
+    address: input.safeAddress, abi: SAFE_ABI, functionName: 'isModuleEnabled', args: [guard],
+  }))) {
+    problems.push(
+      `has guard ${guard}: a guard can veto every transaction of the Safe, and this setup sets none `
+      + `(setGuard(${zeroAddress}) clears it)`,
+    );
+  }
+  if (fallbackHandler !== zeroAddress) {
+    const version = await input.publicClient.readContract({ address: input.safeAddress, abi: SAFE_ABI, functionName: 'VERSION' });
+    const own = COMPATIBILITY_FALLBACK_HANDLERS.get(version) ?? [];
+    if (own.length === 0) {
+      problems.push(
+        `has fallback handler ${fallbackHandler}, and no CompatibilityFallbackHandler of Safe ${version} is known here: `
+        + `the handler decides the Safe's ERC-1271 answers (setFallbackHandler(${zeroAddress}) clears it)`,
+      );
+    } else if (!own.includes(fallbackHandler)) {
+      problems.push(
+        `has fallback handler ${fallbackHandler}, not Safe's CompatibilityFallbackHandler ${version} (${own.join(' or ')}): `
+        + `the handler decides the Safe's ERC-1271 answers (setFallbackHandler(${own[0]}) puts Safe's own back)`,
+      );
+    }
+  }
+  return { guard, fallbackHandler, problems };
+}
