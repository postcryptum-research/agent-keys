# Read in this order: $AGENT_ENV_FILE (default ../../../.env: BASE_SEPOLIA_RPC_URL, BUNDLER_URL),
# then ./.env (overrides).

ANTHROPIC_API_KEY=
# plugin-anthropic 1.5.x always sends `temperature`; keep to models that accept it.
# Its built-in default small model (claude-3-5-haiku-20241022) is retired.
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5
ANTHROPIC_LARGE_MODEL=claude-sonnet-4-6

# BASE_SEPOLIA_RPC_URL=
# AGENT_CONFIG=../../signer/agent.tropic01.base-sepolia.json
# x402: a second permission of the same account that may pay (enables PAY_FOR_URL)
# X402_AGENT_CONFIG=../../signer/agent.x402.base-sepolia.json
# AGENT_SIGNER_BIN=../../signer/target/debug/agent-signer
# AGENT_SPONSORED=0            # make the account pay its own gas

# Local PGlite database (default ./.eliza/pglite). Delete the folder to reset the agent's memory.
# PGLITE_DATA_DIR=

# Encrypts character secrets at rest in the DB; ElizaOS warns when unset.
# SECRET_SALT=
LOG_LEVEL=info
